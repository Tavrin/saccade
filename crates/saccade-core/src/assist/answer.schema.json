{
  "type": "object",
  "additionalProperties": false,
  "required": ["request_hash", "outcome", "observations"],
  "properties": {
    "request_hash": {"type": "string"},
    "outcome": {"type": "string", "enum": ["observed", "not_observed", "unverifiable"]},
    "observations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "kind", "statement", "geometry", "visibility", "evidence_refs", "uncertainty"],
        "properties": {
          "slot": {"type": "string", "enum": ["P1", "P2"]},
          "kind": {"type": "string", "enum": ["text", "presence", "clipping", "overlap", "appearance"]},
          "statement": {"type": "string"},
          "geometry": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "pixels"],
                "properties": {
                  "type": {"type": "string", "enum": ["box"]},
                  "pixels": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "pixels"],
                "properties": {
                  "type": {"type": "string", "enum": ["point"]},
                  "pixels": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}}
                }
              }
            ]
          },
          "visibility": {"type": "string", "enum": ["visible", "partial", "occluded", "unavailable"]},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "uncertainty": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
