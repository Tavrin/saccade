{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-assess.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compare_to": {
      "type": [
        "object",
        "null"
      ]
    },
    "counts": {
      "type": "object"
    },
    "deltas": {
      "type": "object"
    },
    "image": {
      "required": [
        "encoded_sha256",
        "dimensions",
        "measures"
      ],
      "type": "object"
    },
    "learned_score": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string"
        },
        "status": {
          "const": "unavailable"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "type": "object"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "meanings": {
      "type": "object"
    },
    "operation": {
      "const": "assess"
    },
    "related_commands": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-assess.v2"
    },
    "source_refs": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "verdict": {
      "const": "unknown"
    },
    "vision_checks": {
      "additionalProperties": false,
      "properties": {
        "crop_check": {
          "type": "object"
        },
        "faces": {
          "type": "object"
        },
        "watermark": {
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "schema",
    "operation",
    "verdict",
    "counts",
    "image",
    "compare_to",
    "deltas",
    "meanings",
    "learned_score",
    "limitations",
    "report_id",
    "source_refs"
  ],
  "type": "object"
}
