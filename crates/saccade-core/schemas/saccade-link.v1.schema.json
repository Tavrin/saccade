{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-link.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "type": "string"
    },
    "report": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-link.v1"
    }
  },
  "required": [
    "schema",
    "report_id",
    "report",
    "manifest"
  ],
  "type": "object"
}
