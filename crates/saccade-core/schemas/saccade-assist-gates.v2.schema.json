{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-assist-gates.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "gates": {
      "additionalProperties": {
        "const": "PASS"
      },
      "type": "object"
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-assist-gates.v2"
    },
    "source_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "source_hash",
    "gates",
    "report_id",
    "source_refs"
  ],
  "title": "saccade-assist-gates.v1",
  "type": "object"
