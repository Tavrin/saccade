{
  "$defs": {
    "Alignment": {
      "description": "Exposure fit and the declared common mapping.",
      "properties": {
        "exposure_scale": {
          "description": "Scalar multiplying render linear RGB.",
          "format": "double",
          "type": "number"
        },
        "exposure_stops": {
          "description": "log2(exposure_scale).",
          "format": "double",
          "type": "number"
        },
        "method": {
          "description": "Fit algorithm identity.",
          "type": "string"
        },
        "tonemap": {
          "description": "Declared mapping; absent means raw linear RGB.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "exposure_scale",
        "exposure_stops",
        "method"
      ],
      "type": "object"
    },
    "AllowedUnreached": {
      "description": "An explicit readiness exception; it never claims convergence.",
      "properties": {
        "baseline_observed": {
          "description": "Baseline observation, retained even when null."
        },
        "capture_observed": {
          "description": "Candidate observation."
        },
        "criterion": {
          "description": "Exact criterion name.",
          "type": "string"
        }
      },
      "required": [
        "criterion",
        "baseline_observed",
        "capture_observed"
      ],
      "type": "object"
    },
    "Check": {
      "description": "Validity only; this result never contains a pixel pass/fail verdict.",
      "properties": {
        "absent_fields": {
          "default": [],
          "description": "Mapped fields explicitly treating absence as a value, including equal absences.",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "allowed_unreached": {
          "default": [],
          "description": "Explicitly permitted matched unreached predicates with both observations.",
          "items": {
            "$ref": "#/$defs/AllowedUnreached"
          },
          "type": "array"
        },
        "compare": {
          "$ref": "#/$defs/CompareMode",
          "default": "all",
          "description": "Effective map comparison mode, including any CLI override."
        },
        "covered_by_derivation": {
          "default": [],
          "description": "Differences covered by explicit field derivations, with both values.",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "covered_by_vary": {
          "default": [],
          "description": "Differences covered by vary tokens, with matched names and both values.",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "diagnostics": {
          "default": [],
          "description": "Record discovery diagnostics, including exact searched filenames.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "exit_code": {
          "description": "0 valid, 3 invalid difference/readiness, 4 missing identity.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "ignore": {
          "description": "Explicit ignored tokens, including tokens matching no fields.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ignored": {
          "description": "Explicitly waived findings, including missing fields and equal nulls.",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "offending": {
          "description": "Offending fields, sorted by key.",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "type": "array"
        },
        "outcomes": {
          "$ref": "#/$defs/KeySummary",
          "default": {
            "count": 0,
            "keys": [],
            "truncated": false
          },
          "description": "Fields explicitly excluded by the map's outcome globs in either mode."
        },
        "result": {
          "$ref": "#/$defs/ComparisonResult",
          "description": "valid_comparison or invalid_comparison."
        },
        "schema": {
          "description": "Result contract version.",
          "type": "string"
        },
        "unmapped": {
          "$ref": "#/$defs/KeySummary",
          "default": {
            "count": 0,
            "keys": [],
            "truncated": false
          },
          "description": "Unmapped fields; excluded in mapped_only and compared in all mode."
        },
        "vary": {
          "description": "Declared variable tokens.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "result",
        "exit_code",
        "offending",
        "ignore",
        "ignored",
        "vary"
      ],
      "type": "object"
    },
    "CompareMode": {
      "description": "Field selection for arm validity checks.",
      "oneOf": [
        {
          "const": "all",
          "description": "Compare every effective metadata field (the compatibility default).",
          "type": "string"
        },
        {
          "const": "mapped_only",
          "description": "Compare only mapped destinations, readiness and declared derived fields.",
          "type": "string"
        }
      ]
    },
    "ComparisonResult": {
      "description": "Identity validity, independent of any pixel verdict.",
      "oneOf": [
        {
          "const": "valid_comparison",
          "description": "Complete identities differ only in declared variables or explicit ignores.",
          "type": "string"
        },
        {
          "const": "invalid_comparison",
          "description": "Missing or mismatched identity prevents a measurement verdict.",
          "type": "string"
        }
      ]
    },
    "Finding": {
      "description": "A recorded field finding; explicit states distinguish null from absence.",
      "properties": {
        "baseline": {
          "description": "Baseline declaration."
        },
        "baseline_state": {
          "default": "",
          "description": "Baseline state: missing, absent (when explicitly a value), null or value.",
          "type": "string"
        },
        "capture": {
          "description": "Candidate declaration."
        },
        "capture_state": {
          "default": "",
          "description": "Candidate state: missing, absent (when explicitly a value), null or value.",
          "type": "string"
        },
        "key": {
          "description": "Canonical metadata path.",
          "type": "string"
        },
        "reason": {
          "description": "Stable reason: missing, difference, readiness_not_reached, malformed.",
          "type": "string"
        },
        "token_matches": {
          "description": "Tokens covering this finding, with the exact destination or source name matched.",
          "items": {
            "$ref": "#/$defs/TokenMatch"
          },
          "type": "array"
        }
      },
      "required": [
        "key",
        "reason"
      ],
      "type": "object"
    },
    "KeySummary": {
      "description": "Bounded, sorted union of excluded effective keys from both arms.",
      "properties": {
        "count": {
          "description": "Total distinct keys, including keys omitted from the list.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "keys": {
          "description": "At most 64 keys, sorted lexicographically.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "truncated": {
          "description": "Whether the key list omits any keys.",
          "type": "boolean"
        }
      },
      "required": [
        "count",
        "keys",
        "truncated"
      ],
      "type": "object"
    },
    "MatchedName": {
      "description": "Origin of a name matched by an explicit token.",
      "oneOf": [
        {
          "const": "destination",
          "description": "Canonical metadata destination.",
          "type": "string"
        },
        {
          "const": "source",
          "description": "Producer source path from the fingerprint map.",
          "type": "string"
        }
      ]
    },
    "Policy": {
      "additionalProperties": false,
      "description": "Versioned noise/alignment policy.",
      "properties": {
        "absolute_tolerance": {
          "default": 0.001,
          "description": "Absolute linear/mapped luminance tolerance above the noise floor.",
          "format": "double",
          "type": "number"
        },
        "fit_exposure": {
          "default": true,
          "description": "Fit one global render-to-reference exposure gain in linear RGB.",
          "type": "boolean"
        },
        "noise_k": {
          "default": 3.0,
          "description": "Noise-floor multiplier.",
          "format": "double",
          "type": "number"
        },
        "tile_size": {
          "default": 32,
          "description": "Regular tile width/height.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "tonemap": {
          "default": null,
          "description": "Optional aces, hable or reinhard, applied identically to both sides before scoring.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "default": "reference-1",
          "description": "Must be reference-1.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Tile": {
      "description": "Difference evidence for one noisy-reference tile.",
      "properties": {
        "beyond_noise": {
          "description": "Either RMS or signed bias exceeds its recorded noise floor.",
          "type": "boolean"
        },
        "mean_limit": {
          "description": "Noise-derived signed mean tolerance including absolute floor.",
          "format": "double",
          "type": "number"
        },
        "pixels": {
          "description": "Included sample count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rect_px": {
          "description": "Pixel box.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "reference_noise_sigma": {
          "description": "Standard deviation of the reference estimator.",
          "format": "double",
          "type": "number"
        },
        "rms_difference": {
          "description": "Root mean squared luminance difference.",
          "format": "double",
          "type": "number"
        },
        "rms_limit": {
          "description": "Noise-derived RMS tolerance including absolute floor.",
          "format": "double",
          "type": "number"
        },
        "signed_mean": {
          "description": "Signed aligned render-minus-reference luminance.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "rect_px",
        "pixels",
        "signed_mean",
        "rms_difference",
        "reference_noise_sigma",
        "rms_limit",
        "mean_limit",
        "beyond_noise"
      ],
      "type": "object"
    },
    "TokenMatch": {
      "description": "One explicit token match; both names are reported when both match.",
      "properties": {
        "name": {
          "description": "Exact name tested against the token, without a directory image prefix.",
          "type": "string"
        },
        "token": {
          "description": "Literal vary or ignore token.",
          "type": "string"
        },
        "via": {
          "$ref": "#/$defs/MatchedName",
          "description": "Whether the matched name is a canonical destination or producer source."
        }
      },
      "required": [
        "token",
        "via",
        "name"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-reference-evidence.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Offline reference result; source hashes are attached by the transport.",
  "properties": {
    "alignment": {
      "$ref": "#/$defs/Alignment",
      "description": "Fitted alignment parameters."
    },
    "arm_validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Check"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional transport-validated arm identity and explicit exceptions."
    },
    "input_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "Raw source identities filled by file transports.",
      "type": "object"
    },
    "limits": {
      "description": "Interpretation limits.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "mean_flip": {
      "description": "Mean aligned/display-mapped FLIP (secondary diagnostic).",
      "format": "double",
      "type": "number"
    },
    "noise_method": {
      "description": "multiple_seeds, supplied_variance, or high_frequency_estimate.",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/Policy",
      "description": "Exact policy."
    },
    "reference_seeds": {
      "description": "Number of reference seeds averaged (1 for single-reference modes).",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "schema": {
      "const": "saccade-reference-evidence.v1",
      "description": "Versioned discriminator.",
      "type": "string"
    },
    "tiles": {
      "description": "Recorded tile differences and floors.",
      "items": {
        "$ref": "#/$defs/Tile"
      },
      "type": "array"
    },
    "verdict": {
      "description": "within_noise_floor or reference_difference.",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "policy",
    "alignment",
    "noise_method",
    "reference_seeds",
    "verdict",
    "tiles",
    "mean_flip",
    "limits"
  ],
  "title": "Report",
  "type": "object"
}
