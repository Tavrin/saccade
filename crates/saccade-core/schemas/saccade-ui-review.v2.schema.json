{
  "$defs": {
    "Digest": {
      "description": "Validated lowercase SHA-256 identity or content hash.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Finding": {
      "description": "Independent source or uncertain OCR change.",
      "properties": {
        "assurance": {
          "description": "source_fact or uncertain_ocr; neither confers semantic success.",
          "type": "string"
        },
        "evidence": {
          "description": "Before/after values retained exactly."
        },
        "rule": {
          "description": "text_changed, missing_disclosure, reading_order_changed, etc.",
          "type": "string"
        },
        "subject": {
          "description": "Stable node ID or order scope.",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "subject",
        "assurance",
        "evidence"
      ],
      "type": "object"
    },
    "FrozenRegion": {
      "additionalProperties": false,
      "description": "Frozen inclusion mask; never recomputed from surviving candidate objects.",
      "properties": {
        "dimensions": {
          "description": "Image dimensions.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "inclusion": {
          "description": "Binary 0/1 values, row major.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "mask_sha256": {
          "description": "SHA-256 of binary inclusion bytes.",
          "type": "string"
        },
        "provenance": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Authoring method, selector/phrase and model/export provenance when applicable.",
          "type": "object"
        },
        "reference_sha256": {
          "description": "Original reference file hash, not a preview hash.",
          "type": "string"
        },
        "region_id": {
          "description": "Stable region name.",
          "type": "string"
        },
        "schema": {
          "description": "saccade-frozen-region.v1.",
          "type": "string"
        },
        "semantics": {
          "description": "include; black/zero is outside, one is inside.",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "region_id",
        "semantics",
        "reference_sha256",
        "dimensions",
        "inclusion",
        "mask_sha256",
        "provenance"
      ],
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "description": "Measurements do not establish success of the requested semantic edit.",
      "properties": {
        "boundary": {
          "$ref": "#/$defs/Scope",
          "description": "One-pixel four-neighbor boundary, including both sides of the mask."
        },
        "candidate_sha256": {
          "description": "Candidate encoded file hash.",
          "type": "string"
        },
        "collateral": {
          "description": "preserved or collateral_change; never semantic approval.",
          "type": "string"
        },
        "exact_outside": {
          "description": "Whether exact outside preservation was requested.",
          "type": "boolean"
        },
        "inside": {
          "$ref": "#/$defs/Scope",
          "description": "Intended-region measurements."
        },
        "intended_change_detected": {
          "description": "Whether native sample change occurred inside.",
          "type": "boolean"
        },
        "limits": {
          "description": "Numerical/interpretation limits.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "maximum_outside_flip": {
          "description": "Declared perceptual complement threshold when exact_outside is false.",
          "format": "float",
          "type": "number"
        },
        "outside": {
          "$ref": "#/$defs/Scope",
          "description": "Protected complement, with no configuration exclusions applied."
        },
        "pixels_per_degree": {
          "description": "Full-frame viewing condition.",
          "format": "float",
          "type": "number"
        },
        "region": {
          "$ref": "#/$defs/FrozenRegion",
          "description": "Frozen region and its capture identity."
        },
        "report_id": {
          "description": "Content-addressed report identity, absent on historical records.",
          "type": [
            "string",
            "null"
          ]
        },
        "schema": {
          "description": "saccade-localized.v1.",
          "type": "string"
        },
        "source_refs": {
          "description": "External capture URI/key backlinks.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "region",
        "candidate_sha256",
        "pixels_per_degree",
        "inside",
        "outside",
        "boundary",
        "intended_change_detected",
        "exact_outside",
        "maximum_outside_flip",
        "collateral",
        "limits"
      ],
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "description": "One visible/semantic node exported by the capture producer.",
      "properties": {
        "bounds": {
          "description": "x,y,width,height in capture pixels; omitted when unavailable.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "disclosure": {
          "default": false,
          "description": "Explicit disclosure/footnote declaration from the source producer.",
          "type": "boolean"
        },
        "id": {
          "description": "Stable source ID, never matched by approximate text.",
          "type": "string"
        },
        "keyboard_order": {
          "description": "Producer keyboard traversal ordinal; omitted for nonfocusable nodes.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ocr_confidence": {
          "description": "OCR confidence, retained as observation rather than probability/proof.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "reading_order": {
          "description": "Authoritative producer reading ordinal; never geometric top-to-bottom order.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "role": {
          "default": "",
          "description": "Producer-declared role, not an OCR inference.",
          "type": "string"
        },
        "text": {
          "description": "Exact Unicode content; prices and identifiers are not normalized.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "Exact sample and full-frame FLIP statistics within a scope.",
      "properties": {
        "changed_pixels": {
          "description": "Native samples differ at these pixels, including alpha and native bit depth.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_flip": {
          "description": "Maximum full-frame FLIP value in the scope.",
          "format": "double",
          "type": "number"
        },
        "mean_flip": {
          "description": "Ordered mean of full-frame FLIP values in the scope.",
          "format": "double",
          "type": "number"
        },
        "pixels": {
          "description": "Number of pixels in the scope.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pixels",
        "changed_pixels",
        "mean_flip",
        "max_flip"
      ],
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Capture-bound producer text and layout facts.",
      "properties": {
        "capture_sha256": {
          "description": "Exact screenshot file SHA-256 (64 lowercase hex, like DOM region metadata).",
          "type": "string"
        },
        "complete": {
          "description": "True only if the producer declares complete captured source scope.",
          "type": "boolean"
        },
        "dimensions": {
          "description": "Capture-pixel dimensions.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "kind": {
          "description": "dom, accessibility_tree, or tesseract_tsv. Never inferred from image geometry.",
          "type": "string"
        },
        "nodes": {
          "description": "Stable producer IDs for DOM/AX; OCR IDs name geometric word slots only.",
          "items": {
            "$ref": "#/$defs/Node"
          },
          "type": "array"
        },
        "producer": {
          "description": "Producer/version, or pinned OCR executable/model hashes and settings."
        },
        "schema": {
          "const": "saccade-ui-source.v1",
          "description": "saccade-ui-source.v1.",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "capture_sha256",
        "dimensions",
        "kind",
        "producer",
        "nodes",
        "complete"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-ui-review.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One review packet, retaining independent raw/localized measurements.",
  "properties": {
    "findings": {
      "description": "Text/order/layout findings.",
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "type": "array"
    },
    "limits": {
      "description": "Source coverage and interpretation limits.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "localized": {
      "$ref": "#/$defs/Measurement",
      "description": "Existing region, boundary and complement checks without exclusions."
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-ui-review.v2",
      "description": "saccade-ui-review.v1.",
      "type": "string"
    },
    "source_identities": {
      "description": "Semantic hashes of supplied source documents.",
      "items": {
        "$ref": "#/$defs/Digest"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "source_refs": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "sources": {
      "description": "Exact source evidence hashes and producer facts.",
      "items": {
        "$ref": "#/$defs/Source"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "sources",
    "source_identities",
    "findings",
    "localized",
    "limits",
    "report_id",
    "source_refs"
  ],
  "title": "Report",
  "type": "object"
}
