{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-provider-mapping.v1.schema.json",
  "title": "saccade-provider-mapping.v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "saccade-provider-mapping.v1"
    },
    "interface_only": {
      "const": true
    },
    "endpoint": {
      "type": "string"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "body": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "interface_only",
    "endpoint",
    "request_sha256",
    "body"
  ],
  "additionalProperties": false
}
