{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-text.v1.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "saccade-text.v1"
    },
    "operation": {
      "const": "text"
    },
    "verdict": {
      "enum": [
        "pass",
        "regression",
        "unknown"
      ]
    },
    "counts": {
      "type": "object"
    },
    "inputs": {
      "type": "object"
    },
    "producers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
    },
    "observations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
    },
    "comparison": {
      "type": "object",
      "properties": {
        "words": {
          "type": "array"
        },
        "lines": {
          "type": "array"
        },
        "rates": {
          "type": "object"
        },
        "expected": {
          "type": "array"
        }
      },
      "required": [
        "words",
        "lines",
        "rates",
        "expected"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "operation",
    "verdict",
    "counts",
    "inputs",
    "producers",
    "observations",
    "comparison",
    "policy",
    "limitations"
  ],
  "additionalProperties": false
}
