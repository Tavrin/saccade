{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-usage.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-usage.v2"
    },
    "source_refs": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "targets": {
      "items": {
        "properties": {
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "type": [
              "number",
              "null"
            ]
          },
          "crop_rectangle": {
            "items": {
              "type": "number"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "status": {
            "enum": [
              "matched",
              "no_match",
              "failed"
            ]
          },
          "target": {
            "type": "string"
          },
          "transform": {
            "items": {
              "type": "number"
            },
            "maxItems": 9,
            "minItems": 9,
            "type": "array"
          }
        },
        "required": [
          "target",
          "status"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "source_sha256",
    "targets",
    "limitations",
    "report_id",
    "source_refs"
  ],
  "type": "object"
}
