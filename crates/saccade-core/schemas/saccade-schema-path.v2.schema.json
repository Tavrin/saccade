{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-schema-path.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-schema-path.v2"
    },
    "source_refs": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "id",
    "path",
    "report_id",
    "source_refs"
  ],
  "type": "object"
}
