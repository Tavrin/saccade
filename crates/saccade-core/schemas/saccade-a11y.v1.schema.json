{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-a11y.v1.schema.json",
  "title": "a11y PRE-CHECK only; not certification or formal compliance",
  "type": "object",
  "properties": {
    "schema": {
      "const": "saccade-a11y.v1"
    },
    "verdict": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL"
      ]
    },
    "disclaimer": {
      "type": "string"
    },
    "thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "citation": {
            "type": "string"
          },
          "verify": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "value",
          "citation",
          "verify"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model": {
      "type": "string"
    },
    "scale": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "PASS",
              "WARN",
              "FAIL"
            ]
          },
          "original": {
            "type": "string"
          },
          "simulations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "heatmaps": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "information_loss"
                },
                "severity": {
                  "const": "WARN"
                },
                "simulation": {
                  "enum": [
                    "protanopia",
                    "deuteranopia",
                    "tritanopia"
                  ]
                },
                "rect": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "original_delta_e": {
                  "type": "number",
                  "minimum": 0
                },
                "simulated_delta_e": {
                  "type": "number",
                  "minimum": 0
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "severity",
                "simulation",
                "rect",
                "original_delta_e",
                "simulated_delta_e",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "contrast": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "text",
                    "ui"
                  ]
                },
                "rect": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "verdict": {
                  "enum": [
                    "PASS",
                    "WARN",
                    "FAIL"
                  ]
                },
                "foreground": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "background": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "ratio": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 21
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "threshold": {
                  "type": "number",
                  "minimum": 0
                },
                "level": {
                  "enum": [
                    "AA",
                    "AAA"
                  ]
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "kind",
                "rect",
                "verdict",
                "foreground",
                "background",
                "ratio",
                "threshold",
                "level",
                "note"
              ],
              "additionalProperties": false
            }
          },
          "proposals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "text",
                    "ui"
                  ]
                },
                "rect": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "confirmed": {
                  "const": false
                },
                "model": {
                  "type": "string"
                },
                "probability": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "rect",
                "confirmed",
                "model",
                "probability"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "verdict",
          "original",
          "simulations",
          "heatmaps",
          "findings",
          "contrast",
          "proposals"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "verdict",
    "disclaimer",
    "thresholds",
    "warnings",
    "model",
    "scale",
    "images"
  ],
  "additionalProperties": false
}
