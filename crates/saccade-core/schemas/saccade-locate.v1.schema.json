{
  "$defs": {
    "Detection": {
      "additionalProperties": false,
      "description": "One model detection, no recognition identity.",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/Rect",
          "description": "Original-pixel box."
        },
        "mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mask"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional prompted mask."
        },
        "score": {
          "description": "Finite score in [0,1], not a calibrated correctness probability.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "bbox",
        "score"
      ],
      "type": "object"
    },
    "Mask": {
      "additionalProperties": false,
      "description": "Binary mask as sorted non-overlapping `[offset,length]` runs in original pixels.",
      "properties": {
        "runs": {
          "description": "Foreground runs, row-major offsets.",
          "items": {
            "items": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "size": {
          "description": "Original image dimensions.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "size",
        "runs"
      ],
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Explicit model/export attribution on every observation.",
      "properties": {
        "artifact_sha256": {
          "description": "Exact consumed export/auxiliary hashes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "input_resolution": {
          "description": "Actual graph input size.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "model_id": {
          "description": "Model id (or generated fixture id).",
          "type": "string"
        },
        "resolution_handling": {
          "description": "How original resolution was handled.",
          "type": "string"
        },
        "runtime": {
          "description": "onnx-cpu, replay, or external-http; replay is always marked unqualified.",
          "type": "string"
        },
        "source_parity": {
          "description": "Source-model/export parity, independent of successful graph loading.",
          "type": "boolean"
        },
        "version": {
          "description": "Exact model/checkpoint version.",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "version",
        "artifact_sha256",
        "runtime",
        "input_resolution",
        "resolution_handling",
        "source_parity"
      ],
      "type": "object"
    },
    "Rect": {
      "additionalProperties": false,
      "description": "Canonical `[x,y,width,height]` in original pixels; right/bottom exclusive.",
      "properties": {
        "height": {
          "description": "Positive height.",
          "format": "float",
          "type": "number"
        },
        "width": {
          "description": "Positive width.",
          "format": "float",
          "type": "number"
        },
        "x": {
          "description": "Left edge.",
          "format": "float",
          "type": "number"
        },
        "y": {
          "description": "Top edge.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-locate.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Locate receipt with image/prompt binding and separate detector/segmenter identities.",
  "properties": {
    "detections": {
      "description": "Model boxes and optional masks.",
      "items": {
        "$ref": "#/$defs/Detection"
      },
      "type": "array"
    },
    "detector": {
      "$ref": "#/$defs/Provenance",
      "description": "Detection model/export identity."
    },
    "image_sha256": {
      "description": "Exact input file digest.",
      "type": "string"
    },
    "image_size": {
      "description": "Original dimensions.",
      "items": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "phrase_sha256": {
      "description": "Hash of exact phrase UTF-8; text is never executable instructions.",
      "type": "string"
    },
    "schema": {
      "const": "saccade-locate.v1",
      "description": "LOCATE_SCHEMA.",
      "type": "string"
    },
    "segmenter": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ],
      "description": "Segmentation model/export identity, when requested."
    }
  },
  "required": [
    "schema",
    "image_sha256",
    "image_size",
    "phrase_sha256",
    "detections",
    "detector"
  ],
  "title": "LocateReport",
  "type": "object"
}
