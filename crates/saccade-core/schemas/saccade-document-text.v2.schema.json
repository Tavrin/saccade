{
  "$defs": {
    "document": {
      "additionalProperties": false,
      "properties": {
        "pages": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "dimensions": {
                "type": [
                  "array",
                  "null"
                ]
              },
              "index": {
                "minimum": 0,
                "type": "integer"
              },
              "markdown": {
                "type": "string"
              },
              "observations": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "index",
              "markdown",
              "dimensions",
              "observations"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "provenance": {
          "type": "object"
        },
        "schema": {
          "const": "saccade-document-ocr.v1"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "pages",
        "text",
        "provenance"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-document-text.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "comparison": {
      "type": "object"
    },
    "counts": {
      "type": "object"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/document"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "limitations": {
      "type": "array"
    },
    "operation": {
      "const": "text"
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-document-text.v2"
    },
    "source_refs": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "verdict": {
      "enum": [
        "pass",
        "regression",
        "unknown"
      ]
    }
  },
  "required": [
    "schema",
    "operation",
    "verdict",
    "counts",
    "comparison",
    "documents",
    "limitations",
    "report_id",
    "source_refs"
  ],
  "type": "object"
}
