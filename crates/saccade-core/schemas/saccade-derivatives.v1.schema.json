{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "saccade-derivatives.v1"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "rect_px": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "required": [
          "label",
          "rect_px"
        ]
      },
      "maxItems": 64
    },
    "text_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "rect_px": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "required": [
          "label",
          "rect_px"
        ]
      },
      "maxItems": 64
    },
    "derivatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "display_size": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "minItems": 2,
            "maxItems": 2
          },
          "crop_px": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 4,
                "maxItems": 4
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "display_size"
        ]
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "required": [
    "schema",
    "derivatives"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saccade-derivatives.v1",
  "title": "Declared derivative crops, display sizes and source regions"
}
