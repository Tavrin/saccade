{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-onnx-runtime-authority.v1.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "saccade-onnx-runtime-authority.v1"
    },
    "library": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema",
    "library",
    "sha256"
  ],
  "additionalProperties": false
}
