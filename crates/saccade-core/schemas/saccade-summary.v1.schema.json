{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-summary.v1.schema.json",
  "title": "saccade-summary.v1",
  "description": "Printed by `saccade summary --format json` and returned by the MCP summary tool.",
  "type": "object",
  "required": [
    "schema",
    "verdict",
    "regression",
    "mode",
    "labels",
    "totals",
    "failing",
    "failing_omitted",
    "paths"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "saccade-summary.v1"
    },
    "verdict": {
      "enum": [
        "pass",
        "regression"
      ]
    },
    "regression": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "regression",
        "identity"
      ]
    },
    "labels": {
      "type": "object",
      "required": [
        "baseline",
        "capture"
      ],
      "properties": {
        "baseline": {
          "type": "string"
        },
        "capture": {
          "type": "string"
        }
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "total",
        "pass",
        "fail",
        "new",
        "missing",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "failing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "metric",
          "value",
          "threshold"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "new",
              "missing",
              "error"
            ]
          },
          "metric": {
            "enum": [
              "mean",
              "p95",
              "p99",
              "max"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "threshold": {
            "type": "number"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "bit_identical": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "failing_regions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "config_differs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "class": {
            "type": [
              "string",
              "null"
            ],
            "description": "Diagnostics class (identical, noise, global_tone, local_structure, mixed, misaligned, broken_frame), null when diagnostics did not run."
          },
          "buffer": {
            "type": [
              "object",
              "null"
            ],
            "description": "Numerical buffer statistics in depth units, degrees, pixels or changed fraction."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Deterministic plain-English description of the change."
          },
          "hotspots": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "failing_omitted": {
      "type": "integer",
      "minimum": 0
    },
    "paths": {
      "type": "object",
      "required": [
        "report_json",
        "report_dir"
      ],
      "properties": {
        "report_json": {
          "type": "string"
        },
        "report_dir": {
          "type": "string"
        },
        "index_html": {
          "type": [
            "string",
            "null"
          ]
        },
        "explain_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "explain_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "explain_md": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "perf_diff": {
      "anyOf": [
        {
          "$ref": "#/$defs/PerfDiff"
        },
        {
          "type": "null"
        }
      ]
    },
    "perf_errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PerfError"
      }
    },
    "combined_verdict": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "CounterDiff": {
      "properties": {
        "after": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "before": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "beyond_noise": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "delta": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "delta_pct": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "noise_floor": {
          "description": "Raw repeat range in ms (threshold is k times this).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "description": "paired, appeared, disappeared, or not_comparable.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "type": "object"
    },
    "Delta": {
      "properties": {
        "after": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "before": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "beyond_noise": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "delta": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "delta_pct": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "noise_floor": {
          "description": "Raw repeat range in ms (threshold is k times this).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "description": "paired, appeared, disappeared, or not_comparable.",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "Kind": {
      "enum": [
        "pass",
        "gap",
        "scope"
      ],
      "type": "string"
    },
    "TermDiff": {
      "properties": {
        "after": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "after_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/Kind"
            },
            {
              "type": "null"
            }
          ]
        },
        "after_parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "before": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "before_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/Kind"
            },
            {
              "type": "null"
            }
          ]
        },
        "before_parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "beyond_noise": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "counters": {
          "items": {
            "$ref": "#/$defs/CounterDiff"
          },
          "type": "array"
        },
        "delta": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "delta_pct": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "label": {
          "type": "string"
        },
        "noise_floor": {
          "description": "Raw repeat range in ms (threshold is k times this).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "share_after": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "share_before": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "description": "paired, appeared, disappeared, or not_comparable.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "status",
        "counters"
      ],
      "type": "object"
    },
    "PerfDiff": {
      "properties": {
        "frame": {
          "$ref": "#/$defs/Delta"
        },
        "noise_k": {
          "format": "double",
          "type": "number"
        },
        "schema": {
          "type": "string"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/TermDiff"
          },
          "type": "array"
        },
        "unattributed_after": {
          "format": "double",
          "type": "number"
        },
        "unattributed_before": {
          "format": "double",
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "unit",
        "noise_k",
        "frame",
        "unattributed_before",
        "unattributed_after",
        "terms",
        "warnings"
      ],
      "title": "PerfDiff",
      "type": "object"
    },
    "PerfError": {
      "properties": {
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "message"
      ],
      "type": "object"
    }
  }
}
