{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-question-report.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "counts": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "minimum": 0,
          "type": "integer"
        },
        "failures": {
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total",
        "failures",
        "errors"
      ],
      "type": "object"
    },
    "entries": {
      "items": {
        "required": [
          "name",
          "status"
        ],
        "type": "object"
      },
      "maxItems": 100000,
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "operation": {
      "const": "quality"
    },
    "pipeline_choice": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "fallback": {
          "const": "none"
        },
        "family": {
          "type": "string"
        },
        "measurement": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "schema": {
              "const": "saccade-report.v1"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "verdict": {
              "enum": [
                "pass",
                "regression"
              ]
            }
          },
          "required": [
            "schema",
            "path",
            "sha256",
            "verdict"
          ],
          "type": "object"
        },
        "question": {
          "enum": [
            "same-render",
            "same-content",
            "same-text",
            "near-duplicate",
            "quality"
          ]
        },
        "reason": {
          "type": "string"
        },
        "schema": {
          "const": "saccade-pipeline-choice.v1"
        }
      },
      "required": [
        "schema",
        "question",
        "family",
        "command",
        "reason",
        "fallback"
      ],
      "type": "object"
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-question-report.v2"
    },
    "source_refs": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "verdict": {
      "enum": [
        "unknown",
        "regression"
      ]
    }
  },
  "required": [
    "schema",
    "operation",
    "verdict",
    "counts",
    "entries",
    "limitations",
    "pipeline_choice",
    "report_id",
    "source_refs"
  ],
  "type": "object"
}
