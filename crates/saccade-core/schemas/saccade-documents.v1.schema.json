{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-documents.v1.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "saccade-documents.v1"
    },
    "operation": {
      "const": "documents_compare"
    },
    "verdict": {
      "enum": [
        "pass",
        "regression"
      ]
    },
    "counts": {
      "type": "object"
    },
    "inputs": {
      "type": "object"
    },
    "rendering": {
      "type": "object"
    },
    "pages": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "status": {
            "enum": [
              "pass",
              "regression",
              "new",
              "missing",
              "error"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array"
    }
  },
  "required": [
    "schema",
    "operation",
    "verdict",
    "counts",
    "inputs",
    "rendering",
    "pages",
    "limitations"
  ],
  "additionalProperties": false
}
