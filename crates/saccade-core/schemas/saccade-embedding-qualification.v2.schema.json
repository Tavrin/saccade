{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-embedding-qualification.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "calibration": {
      "type": "object"
    },
    "checkpoint_sha256": {
      "type": "string"
    },
    "corpus_sha256": {
      "type": "string"
    },
    "counts": {
      "type": "object"
    },
    "export_sha256": {
      "type": "string"
    },
    "limits": {
      "type": "array"
    },
    "operation": {
      "const": "embedding_qualification"
    },
    "parity": {
      "type": "array"
    },
    "qualified_model_contract_sha256": {
      "type": "string"
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-embedding-qualification.v2"
    },
    "scope": {
      "type": "string"
    },
    "source_refs": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "source_revision": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "regression"
      ]
    }
  },
  "required": [
    "schema",
    "operation",
    "verdict",
    "counts",
    "corpus_sha256",
    "export_sha256",
    "checkpoint_sha256",
    "source_revision",
    "scope",
    "parity",
    "calibration",
    "qualified_model_contract_sha256",
    "limits",
    "report_id",
    "source_refs"
  ],
  "type": "object"
}
