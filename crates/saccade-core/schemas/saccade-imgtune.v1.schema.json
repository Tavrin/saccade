{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saccade-imgtune.v1",
  "title": "saccade-imgtune.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "saccade-imgtune.v1"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "current": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "current"
        ],
        "additionalProperties": false
      }
    },
    "widths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "integer",
        "minimum": 8,
        "maximum": 16384
      }
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "enum": [
          "jpeg",
          "webp",
          "avif",
          "png"
        ]
      }
    },
    "qualities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "target_score": {
      "type": "number",
      "maximum": 100
    },
    "butteraugli_ceiling": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "adapter": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "local"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "url_template"
            },
            "template": {
              "type": "string"
            },
            "accept": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "template",
            "accept"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema",
    "images",
    "widths",
    "formats",
    "qualities",
    "target_score",
    "butteraugli_ceiling",
    "adapter"
  ],
  "additionalProperties": false
}
