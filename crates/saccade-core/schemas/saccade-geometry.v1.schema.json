{
  "$defs": {
    "Analysis": {
      "additionalProperties": false,
      "description": "One optional result. Historical absence cannot imply successful execution.",
      "properties": {
        "capability": {
          "$ref": "#/$defs/Capability",
          "description": "Whether this producer established the requested evidence."
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeometryDiff"
            },
            {
              "type": "null"
            }
          ],
          "description": "Measurements, never an independent approval authority."
        },
        "limitations": {
          "description": "Scope restrictions in stable order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reproduction information; absent for historical, unrecorded evidence."
        }
      },
      "required": [
        "capability",
        "limitations"
      ],
      "type": "object"
    },
    "Analysis2": {
      "additionalProperties": false,
      "description": "One optional result. Historical absence cannot imply successful execution.",
      "properties": {
        "capability": {
          "$ref": "#/$defs/Capability",
          "description": "Whether this producer established the requested evidence."
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ],
          "description": "Measurements, never an independent approval authority."
        },
        "limitations": {
          "description": "Scope restrictions in stable order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reproduction information; absent for historical, unrecorded evidence."
        }
      },
      "required": [
        "capability",
        "limitations"
      ],
      "type": "object"
    },
    "Asset": {
      "description": "Exact source/decoded geometry identity and producer's LOD label.",
      "properties": {
        "document_sha256": {
          "description": "Lowercase SHA256 of the source document bytes.",
          "type": "string"
        },
        "geometry_sha256": {
          "description": "Ordered decoded geometry identity from the geometry comparison.",
          "type": "string"
        },
        "lod": {
          "description": "Human-readable LOD/cut identity, never inferred from image similarity.",
          "type": "string"
        }
      },
      "required": [
        "document_sha256",
        "geometry_sha256",
        "lod"
      ],
      "type": "object"
    },
    "Camera": {
      "description": "Common view matrices. Arrays are row-major and act on column vectors.",
      "properties": {
        "convention": {
          "description": "Must be row_major_column_vector_right_handed_clip_z_zero_to_one.",
          "type": "string"
        },
        "model_to_world": {
          "description": "Placement of the already decoded world geometry into the render world.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 16,
          "minItems": 16,
          "type": "array"
        },
        "projection": {
          "description": "Camera to homogeneous clip coordinates, with declared Z range.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 16,
          "minItems": 16,
          "type": "array"
        },
        "world_to_view": {
          "description": "Render world to camera transformation.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 16,
          "minItems": 16,
          "type": "array"
        }
      },
      "required": [
        "convention",
        "model_to_world",
        "world_to_view",
        "projection"
      ],
      "type": "object"
    },
    "Capability": {
      "description": "Availability is separate from a measurement or verdict.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The requested computation was performed within its declared scope.",
          "properties": {
            "state": {
              "const": "available",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Evidence was not supplied or cannot establish applicability.",
          "properties": {
            "reason": {
              "description": "Machine-readable explanation.",
              "type": "string"
            },
            "state": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "This implementation cannot perform the requested computation.",
          "properties": {
            "reason": {
              "description": "Machine-readable explanation.",
              "type": "string"
            },
            "state": {
              "const": "unsupported",
              "type": "string"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The caller explicitly excluded the computation.",
          "properties": {
            "reason": {
              "description": "Machine-readable explanation.",
              "type": "string"
            },
            "state": {
              "const": "excluded",
              "type": "string"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Inputs or execution failed validation.",
          "properties": {
            "reason": {
              "description": "Machine-readable explanation.",
              "type": "string"
            },
            "state": {
              "const": "rejected",
              "type": "string"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "Context": {
      "description": "Renderer and environment identity shared by both assets and all views.",
      "properties": {
        "background_sha256": {
          "description": "Background content identity.",
          "type": "string"
        },
        "color_pipeline_sha256": {
          "description": "Colour pipeline/profile/display transform identity.",
          "type": "string"
        },
        "dimensions": {
          "description": "Image dimensions; no resizing is allowed.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "lighting_sha256": {
          "description": "Lighting/environment content identity.",
          "type": "string"
        },
        "material_mode": {
          "description": "asset_materials or override_materials.",
          "type": "string"
        },
        "override_material_sha256": {
          "description": "Override material identity; required only in override mode.",
          "type": [
            "string",
            "null"
          ]
        },
        "renderer": {
          "description": "Producer name/version, retained alongside hashes.",
          "type": "string"
        },
        "renderer_binary_sha256": {
          "description": "Exact executable identity asserted by the producer.",
          "type": "string"
        },
        "renderer_source_sha256": {
          "description": "Renderer source revision/content identity.",
          "type": "string"
        },
        "settings_sha256": {
          "description": "Render settings, including temporal sample/frame policy.",
          "type": "string"
        }
      },
      "required": [
        "renderer",
        "renderer_source_sha256",
        "renderer_binary_sha256",
        "settings_sha256",
        "lighting_sha256",
        "background_sha256",
        "color_pipeline_sha256",
        "material_mode",
        "dimensions"
      ],
      "type": "object"
    },
    "Coverage": {
      "description": "Finite-view coverage; never an angular or surface coverage bound.",
      "properties": {
        "declared_views": {
          "description": "All required cameras, including absent/rejected evidence.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "fraction": {
          "description": "measured_views / declared_views.",
          "format": "double",
          "type": "number"
        },
        "measured_views": {
          "description": "Successfully measured pairs.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "missing_views": {
          "description": "Missing receipt or file pairs.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "rejected_views": {
          "description": "Other rejected pairs.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "supplied_pairs": {
          "description": "Both render receipts supplied, independent of validity.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "declared_views",
        "supplied_pairs",
        "measured_views",
        "missing_views",
        "rejected_views",
        "fraction"
      ],
      "type": "object"
    },
    "Directed": {
      "description": "Directed area-weighted distance distribution and separate defect probes.",
      "properties": {
        "area_samples": {
          "description": "Deterministic area samples; each triangle gets at least one.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "defect_probes": {
          "description": "Additional vertex/edge probes used only for the maximum.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "maximum": {
          "description": "Maximum among area samples and defect probes; a sampled lower estimate.",
          "format": "double",
          "type": "number"
        },
        "mean": {
          "description": "Unsquared distance in declared length units, weighted by triangle area.",
          "format": "double",
          "type": "number"
        },
        "normal_ambiguous_area_fraction": {
          "description": "Fraction of area samples whose projection hits an edge/vertex; normal correspondence unknown.",
          "format": "double",
          "type": "number"
        },
        "normal_max_degrees": {
          "description": "Largest measured oriented face-normal angle.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "normal_mean_degrees": {
          "description": "Area-weighted oriented face-normal angle in degrees where correspondence is unambiguous.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "p95": {
          "description": "Weighted 95th percentile over area samples.",
          "format": "double",
          "type": "number"
        },
        "p99": {
          "description": "Weighted 99th percentile over area samples.",
          "format": "double",
          "type": "number"
        },
        "rms": {
          "description": "Root mean squared distance in declared length units.",
          "format": "double",
          "type": "number"
        },
        "surface_area": {
          "description": "Total sampled source surface area.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "area_samples",
        "defect_probes",
        "surface_area",
        "maximum",
        "mean",
        "rms",
        "p95",
        "p99",
        "normal_ambiguous_area_fraction"
      ],
      "type": "object"
    },
    "GeometryDiff": {
      "description": "Bidirectional surface evidence, never a certified continuous Hausdorff bound.",
      "properties": {
        "baseline_to_capture": {
          "$ref": "#/$defs/Directed",
          "description": "Baseline surface samples projected to capture triangles."
        },
        "capture_to_baseline": {
          "$ref": "#/$defs/Directed",
          "description": "Capture surface samples projected to baseline triangles."
        },
        "identity": {
          "$ref": "#/$defs/Identity",
          "description": "Ordered geometry identity, a separate exact claim."
        },
        "mean": {
          "description": "Arithmetic average of the directed unsquared means.",
          "format": "double",
          "type": "number"
        },
        "rms": {
          "description": "Square root of the average directed mean squared distances.",
          "format": "double",
          "type": "number"
        },
        "sampled_hausdorff": {
          "description": "Maximum of the directed sampled maxima; lower estimate subject to floating-point error.",
          "format": "double",
          "type": "number"
        },
        "unit": {
          "description": "Declared length units.",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "identity",
        "baseline_to_capture",
        "capture_to_baseline",
        "sampled_hausdorff",
        "mean",
        "rms"
      ],
      "type": "object"
    },
    "Identity": {
      "description": "Exact identity of the declared geometry, distinct from sampled surface similarity.",
      "properties": {
        "appearance_attributes": {
          "$ref": "#/$defs/Capability",
          "description": "This proof does not establish equal UVs, materials, textures or shading normals."
        },
        "geometry_sha256": {
          "description": "Content identities of the decoded ordered geometry.",
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "ordered_geometry_identical": {
          "description": "Exact ordered f64 world vertices and u32 triangle indices, including unit declaration.",
          "type": "boolean"
        },
        "source_geometry_resources_identical": {
          "description": "Source document and loaded geometry buffer bytes match in resource order.",
          "type": "boolean"
        },
        "unit": {
          "description": "Units supplied by the caller; no implicit unit conversion.",
          "type": "string"
        }
      },
      "required": [
        "ordered_geometry_identical",
        "source_geometry_resources_identical",
        "geometry_sha256",
        "unit",
        "appearance_attributes"
      ],
      "type": "object"
    },
    "ImagePin": {
      "description": "Exact supplied image or fractional silhouette mask bytes.",
      "properties": {
        "path": {
          "description": "Local path inside the camera manifest directory.",
          "type": "string"
        },
        "sha256": {
          "description": "Lowercase SHA256 of the encoded file.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "Manifest": {
      "description": "Frozen finite-view acquisition declaration; does not invoke a renderer.",
      "properties": {
        "assets": {
          "description": "Reference/candidate assets, respectively.",
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/Context",
          "description": "Common controlled renderer environment."
        },
        "maximum_mean_flip": {
          "description": "Per-view raw mean threshold.",
          "format": "double",
          "type": "number"
        },
        "maximum_silhouette_change": {
          "description": "Fractional absolute silhouette change threshold, if masks are supplied.",
          "format": "double",
          "type": "number"
        },
        "pixels_per_degree": {
          "description": "FLIP viewing parameter.",
          "format": "float",
          "type": "number"
        },
        "schema": {
          "const": "saccade-asset-views.v1",
          "description": "Contract identity.",
          "type": "string"
        },
        "unit": {
          "description": "Same unit declaration as the geometry report.",
          "type": "string"
        },
        "views": {
          "description": "Every required distinct camera, in producer-declared order.",
          "items": {
            "$ref": "#/$defs/View"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "unit",
        "assets",
        "context",
        "views",
        "pixels_per_degree",
        "maximum_mean_flip",
        "maximum_silhouette_change"
      ],
      "type": "object"
    },
    "Measurement": {
      "description": "Per-view raw evidence, including missing/rejected views.",
      "properties": {
        "camera_sha256": {
          "description": "Canonical paired camera identity.",
          "type": "string"
        },
        "error_map": {
          "description": "Row-major raw FLIP errors, allowing local defects to be inspected.",
          "items": {
            "format": "float",
            "type": "number"
          },
          "type": "array"
        },
        "flip": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metrics"
            },
            {
              "type": "null"
            }
          ],
          "description": "Unaligned full-frame FLIP, absent if the pair is invalid."
        },
        "high_error_bounds": {
          "description": "Bounds of raw errors exceeding maximum_mean_flip (not a segmentation).",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "id": {
          "description": "Corresponding declared view name.",
          "type": "string"
        },
        "issues": {
          "description": "Input/identity failures; an absent measurement is never a zero score.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "regression": {
          "description": "Threshold outcome; unknown for unmeasured pairs.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "silhouette": {
          "anyOf": [
            {
              "$ref": "#/$defs/Silhouette"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional paired mask evidence."
        },
        "state": {
          "description": "measured, missing_render, or rejected_render.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "camera_sha256",
        "state",
        "issues",
        "error_map"
      ],
      "type": "object"
    },
    "Metrics": {
      "description": "FLIP error-map statistics. All error values are in `[0, 1]`; a non-finite\nvalue (which a valid run does not produce) is serialized as `null` and read\nback as NaN.",
      "properties": {
        "frac_above_0_1": {
          "description": "Fraction of pixels with error > 0.1.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "frac_above_0_5": {
          "description": "Fraction of pixels with error > 0.5.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "height": {
          "description": "Image height in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max": {
          "description": "Maximum error.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "mean": {
          "description": "Mean error.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "p50": {
          "description": "Median error.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "p95": {
          "description": "95th-percentile error.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "p99": {
          "description": "99th-percentile error.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "width": {
          "description": "Image width in pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Reproduction details shared by optional analysis features.",
      "properties": {
        "code_license": {
          "description": "SPDX expression for this implementation.",
          "type": "string"
        },
        "implementation": {
          "description": "Algorithm name and revision, independently of the tool version.",
          "type": "string"
        },
        "resources": {
          "description": "Exact resources, in producer-declared stable order.",
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "type": "array"
        },
        "settings": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Explicit preprocessing, execution and sampling settings.",
          "type": "object"
        },
        "tool_version": {
          "description": "Producing package version.",
          "type": "string"
        }
      },
      "required": [
        "implementation",
        "tool_version",
        "code_license",
        "resources",
        "settings"
      ],
      "type": "object"
    },
    "Render": {
      "description": "Producer assertion binding one render to camera, context and asset.",
      "properties": {
        "asset_document_sha256": {
          "description": "Corresponding asset document identity.",
          "type": "string"
        },
        "asset_geometry_sha256": {
          "description": "Corresponding decoded geometry identity.",
          "type": "string"
        },
        "camera_sha256": {
          "description": "Canonical camera object hash.",
          "type": "string"
        },
        "context_sha256": {
          "description": "Canonical render context object hash.",
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/ImagePin",
          "description": "Supplied render image."
        },
        "materials_sha256": {
          "description": "Material content identity; may differ in asset_materials mode.",
          "type": "string"
        },
        "silhouette": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImagePin"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional L8 PNG object coverage, 0..255 including partial coverage."
        },
        "textures_sha256": {
          "description": "Ordered content identities of texture inputs, including normal maps.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "image",
        "camera_sha256",
        "context_sha256",
        "asset_document_sha256",
        "asset_geometry_sha256",
        "materials_sha256",
        "textures_sha256"
      ],
      "type": "object"
    },
    "Report": {
      "description": "Multi-view packet embedded additively in saccade-geometry.v1.",
      "properties": {
        "context_sha256": {
          "description": "Canonical common renderer/context identity.",
          "type": "string"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage",
          "description": "Explicit acquired/measured coverage."
        },
        "limitations": {
          "description": "Limits of supplied, finite-view render evidence.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "manifest": {
          "$ref": "#/$defs/Manifest",
          "description": "Complete supplied declaration and receipts."
        },
        "manifest_sha256": {
          "description": "Canonical body identity of the manifest.",
          "type": "string"
        },
        "passed": {
          "description": "True only with complete coverage and no declared-threshold regression.",
          "type": "boolean"
        },
        "schema": {
          "const": "saccade-asset-view-report.v1",
          "description": "Contract identity.",
          "type": "string"
        },
        "views": {
          "description": "All views, including failures.",
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "type": "array"
        },
        "worst_view": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorstView"
            },
            {
              "type": "null"
            }
          ],
          "description": "Worst measured raw mean view, absent when none were measured."
        }
      },
      "required": [
        "schema",
        "manifest",
        "manifest_sha256",
        "context_sha256",
        "views",
        "coverage",
        "passed",
        "limitations"
      ],
      "type": "object"
    },
    "Resource": {
      "additionalProperties": false,
      "description": "Content-bound resource; absent hashes or licences remain explicit unknowns.",
      "properties": {
        "license": {
          "description": "SPDX expression or a referenced custom licence; never inferred from code.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Logical resource name, not a machine-specific path.",
          "type": "string"
        },
        "role": {
          "description": "Role such as input, implementation, weights or configuration.",
          "type": "string"
        },
        "sha256": {
          "description": "Lowercase SHA-256 of exact resource bytes, when available.",
          "type": [
