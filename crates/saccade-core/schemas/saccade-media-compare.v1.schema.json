{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-media-compare.v1.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "saccade-media-compare.v1"
    },
    "reference_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metrics": {
      "type": "object"
    },
    "ppd": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "schema",
    "reference_sha256",
    "capture_sha256",
    "metrics",
    "ppd"
  ],
  "additionalProperties": false
}
