{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-inbox-item.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Persisted `saccade-inbox-item.v1`.",
  "properties": {
    "allowed_answers": {
      "description": "Allowed human answers.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "answer": {
      "description": "Human's answer, absent while open.",
      "type": [
        "string",
        "null"
      ]
    },
    "answered_unix": {
      "description": "Answer time.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "context": {
      "description": "Supporting context.",
      "type": [
        "string",
        "null"
      ]
    },
    "created_unix": {
      "description": "Creation time.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "from": {
      "description": "Asking agent.",
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "description": "Opaque hex id.",
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    },
    "link": {
      "description": "Local deep link.",
      "type": [
        "string",
        "null"
      ]
    },
    "note": {
      "description": "Human's note.",
      "type": [
        "string",
        "null"
      ]
    },
    "question": {
      "description": "Question text.",
      "type": "string"
    },
    "schema": {
      "const": "saccade-inbox-item.v1",
      "description": "Schema identifier.",
      "type": "string"
    },
    "status": {
      "description": "open or answered.",
      "enum": [
        "open",
        "answered"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema",
    "id",
    "question",
    "allowed_answers",
    "status",
    "created_unix"
  ],
  "title": "Item",
  "type": "object"
}
