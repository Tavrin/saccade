{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-page-map.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "saccade-page-map.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "saccade-page-map.v1"
    },
    "reference_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reference": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 500
          },
          "candidate": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 500
          }
        },
        "required": [
          "reference",
          "candidate"
        ],
        "not": {
          "properties": {
            "reference": {
              "type": "null"
            },
            "candidate": {
              "type": "null"
            }
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "reference_sha256",
    "candidate_sha256",
    "pairs"
  ]
}
