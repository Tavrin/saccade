{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-capabilities.v1.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "saccade-capabilities.v1"
    },
    "operation": {
      "const": "capabilities"
    },
    "compiled_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "families": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "inputs": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "limits": {
            "type": "string"
          },
          "features_required": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "family",
          "command",
          "inputs",
          "features_required",
          "status",
          "question",
          "limits"
        ],
        "additionalProperties": false
      }
    },
    "routing": {
      "type": "object",
      "required": [
        "same-render",
        "same-content",
        "same-text",
        "near-duplicate",
        "quality"
      ],
      "properties": {
        "same-render": {
          "type": "string"
        },
        "same-content": {
          "type": "string"
        },
        "same-text": {
          "type": "string"
        },
        "near-duplicate": {
          "type": "string"
        },
        "quality": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "operation",
    "compiled_features",
    "families",
    "routing",
    "limitations"
  ],
  "additionalProperties": false
}
