{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saccade-sweep.v1",
  "title": "saccade-sweep.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "saccade-sweep.v1"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "group": {
            "type": "string"
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "viewport": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 8,
              "maximum": 16384
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "id",
          "group",
          "before",
          "after",
          "viewport"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100000
    }
  },
  "required": [
    "schema",
    "seed",
    "pages"
  ],
  "additionalProperties": false
}
