{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "One replayed draw, dispatch or clear, in event order.",
      "properties": {
        "action_key": {
          "description": "Stable authored action name, or supporting draw/dispatch signature.",
          "type": "string"
        },
        "candidate_inputs": {
          "description": "Capture-local bound input resources for follow-up, never asserted causes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "event_id": {
          "description": "Capture-local event ID.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "description": "draw, dispatch or clear.",
          "type": "string"
        },
        "marker_path": {
          "description": "Stable marker hierarchy; occurrence suffixes remain evidence, not certainty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "marker_unique": {
          "description": "False for repeated/unmarked marker ancestry; matching abstains.",
          "type": "boolean"
        },
        "resources": {
          "description": "Native bound output/storage resource observations.",
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "marker_path",
        "marker_unique",
        "kind",
        "action_key",
        "resources",
        "candidate_inputs"
      ],
      "type": "object"
    },
    "Resource": {
      "additionalProperties": false,
      "description": "One native resource observation after an action.",
      "properties": {
        "bytes": {
          "description": "Exact extracted bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "dimensions": {
          "description": "Width, height, depth; buffers use [byte length,1,1].",
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "error": {
          "description": "Explicit extraction/capability error.",
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "description": "Native storage/view format; no thumbnail conversion.",
          "type": "string"
        },
        "interpretation": {
          "description": "native_bytes; never display-converted numerical evidence.",
          "type": "string"
        },
        "payload": {
          "description": "Relative raw payload path, or null on extraction error.",
          "type": [
            "string",
            "null"
          ]
        },
        "resource_id": {
          "description": "Capture-local resource ID, retained only as evidence.",
          "type": "string"
        },
        "role": {
          "description": "Stable bound role, such as color0, depth or rw:Compute:0:0.",
          "type": "string"
        },
        "sha256": {
          "description": "Raw payload hash, or null on extraction error.",
          "type": [
            "string",
            "null"
          ]
        },
        "subresource": {
          "description": "Exact mip, layer and sample. This MVP extracts one descriptor subresource.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "role",
        "resource_id",
        "format",
        "dimensions",
        "subresource",
        "interpretation"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-renderdoc-extract.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Version-pinned official-binding worker extraction.",
  "properties": {
    "actions": {
      "description": "Every bounded draw/dispatch/clear in event order.",
      "items": {
        "$ref": "#/$defs/Action"
      },
      "type": "array"
    },
    "api": {
      "description": "Vulkan only for this MVP.",
      "type": "string"
    },
    "capture_sha256": {
      "description": "SHA-256 of original .rdc bytes.",
      "type": "string"
    },
    "limits": {
      "description": "Coverage and interpretation limits.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "renderdoc_version": {
      "description": "Official RenderDoc version, pinned to 1.34.",
      "type": "string"
    },
    "repeatability": {
      "description": "self_replay_byte_identical or unqualified.",
      "type": "string"
    },
    "replay_mode": {
      "description": "conservative; intermediate contents are not optimized away.",
      "type": "string"
    },
    "schema": {
      "description": "saccade-renderdoc-extract.v1.",
      "type": "string"
    },
    "worker_sha256": {
      "description": "SHA-256 of worker source bytes.",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "capture_sha256",
    "worker_sha256",
    "renderdoc_version",
    "api",
    "replay_mode",
    "repeatability",
    "actions",
    "limits"
  ],
  "title": "Capture",
  "type": "object"
}
