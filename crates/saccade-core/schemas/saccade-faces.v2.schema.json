{
  "$defs": {
    "Face": {
      "additionalProperties": false,
      "description": "Face box and optional landmarks, never an identity.",
      "properties": {
        "bbox": {
          "$ref": "#/$defs/Rect",
          "description": "Original-pixel box."
        },
        "landmarks": {
          "description": "Original-pixel landmarks; empty for exports without a landmark head.",
          "items": {
            "items": {
              "format": "float",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "score": {
          "description": "Predicted detection score.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "bbox",
        "score",
        "landmarks"
      ],
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Explicit model/export attribution on every observation.",
      "properties": {
        "artifact_sha256": {
          "description": "Exact consumed export/auxiliary hashes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "input_resolution": {
          "description": "Actual graph input size.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "model_id": {
          "description": "Model id (or generated fixture id).",
          "type": "string"
        },
        "resolution_handling": {
          "description": "How original resolution was handled.",
          "type": "string"
        },
        "runtime": {
          "description": "onnx-cpu, replay, or external-http; replay is always marked unqualified.",
          "type": "string"
        },
        "source_parity": {
          "description": "Source-model/export parity, independent of successful graph loading.",
          "type": "boolean"
        },
        "version": {
          "description": "Exact model/checkpoint version.",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "version",
        "artifact_sha256",
        "runtime",
        "input_resolution",
        "resolution_handling",
        "source_parity"
      ],
      "type": "object"
    },
    "Rect": {
      "additionalProperties": false,
      "description": "Canonical `[x,y,width,height]` in original pixels; right/bottom exclusive.",
      "properties": {
        "height": {
          "description": "Positive height.",
          "format": "float",
          "type": "number"
        },
        "width": {
          "description": "Positive width.",
          "format": "float",
          "type": "number"
        },
        "x": {
          "description": "Left edge.",
          "format": "float",
          "type": "number"
        },
        "y": {
          "description": "Top edge.",
          "format": "float",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-faces.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Source-bound face detector receipt.",
  "properties": {
    "faces": {
      "description": "Detected faces, never recognition labels.",
      "items": {
        "$ref": "#/$defs/Face"
      },
      "type": "array"
    },
    "image_sha256": {
      "description": "Exact encoded image digest.",
      "type": "string"
    },
    "image_size": {
      "description": "Original resolution.",
      "items": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "limitations": {
      "description": "Mandatory detection-recall limits.",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance",
      "description": "Exact model/export identity."
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-faces.v2",
      "description": "FACES_SCHEMA.",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "image_sha256",
    "image_size",
    "faces",
    "provenance",
    "limitations",
    "report_id",
    "source_refs"
  ],
  "title": "FaceReport",
  "type": "object"
}
