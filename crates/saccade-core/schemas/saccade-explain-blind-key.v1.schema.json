{
  "$defs": {
    "BlindItem": {
      "description": "One blind choice made for the key.",
      "properties": {
        "a": {
          "description": "True label of the side shown as `A`.",
          "type": "string"
        },
        "b": {
          "description": "True label of the side shown as `B`.",
          "type": "string"
        },
        "entry": {
          "description": "Image name.",
          "type": "string"
        },
        "hotspot": {
          "description": "Hotspot index, or `null` for the whole-frame strip.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "entry",
        "a",
        "b"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-explain-blind-key.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The `blind-key.json` file of a blind pack. Keep it from the judge.",
  "properties": {
    "items": {
      "description": "One item per strip.",
      "items": {
        "$ref": "#/$defs/BlindItem"
      },
      "type": "array"
    },
    "schema": {
      "description": "Always [`EXPLAIN_BLIND_KEY_SCHEMA`].",
      "type": "string"
    },
    "seed": {
      "description": "The shuffle seed.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "seed",
    "items"
  ],
  "title": "ExplainBlindKey",
  "type": "object"
}
