{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-embedding-corpus.v1.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "saccade-embedding-corpus.v1"
    },
    "export_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checkpoint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "parity_tolerance": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.001
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096
    }
  },
  "required": [
    "schema",
    "export_sha256",
    "checkpoint_sha256",
    "source_revision",
    "scope",
    "parity_tolerance",
    "samples",
    "pairs"
  ],
  "additionalProperties": false
}
