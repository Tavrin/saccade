{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-api-health.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "media_schema": {
      "const": "saccade-media-record.v1"
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-api-health.v2"
    },
    "source_refs": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "status": {
      "const": "ok"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "status",
    "media_schema",
    "version",
    "report_id",
    "source_refs"
  ],
  "type": "object"
}
