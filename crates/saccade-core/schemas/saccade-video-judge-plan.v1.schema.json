{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tavrin.github.io/saccade/schemas/saccade-video-judge-plan.v1.schema.json",
  "title": "Offline video judge priced plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "price_id",
    "price_source",
    "price_date",
    "frame_bound",
    "safety_factor",
    "max_spend_nano_usd",
    "reservation_nano_usd",
    "rows",
    "native_mp4",
    "scores_format"
  ],
  "properties": {
    "schema": {
      "const": "saccade-video-judge-plan.v1"
    },
    "authority": {
      "type": "string"
    },
    "price_id": {
      "type": "string"
    },
    "price_source": {
      "type": "string"
    },
    "price_date": {
      "type": "string"
    },
    "frame_bound": {
      "type": "string"
    },
    "safety_factor": {
      "type": "integer",
      "minimum": 2
    },
    "max_spend_nano_usd": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000000
    },
    "reservation_nano_usd": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000000
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "model",
          "order",
          "input_bound",
          "output_bound",
          "reservation_nano_usd",
          "request_hash",
          "repeat",
          "image_table",
          "schema_projection"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "input_bound": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128000
          },
          "output_bound": {
            "type": "integer",
            "const": 1024
          },
          "reservation_nano_usd": {
            "type": "integer",
            "minimum": 1
          },
          "request_hash": {
            "type": "string"
          },
          "repeat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "image_table": {
            "type": "string"
          },
          "schema_projection": {
            "type": "string"
          }
        }
      }
    },
    "native_mp4": {
      "type": "string"
    },
    "scores_format": {
      "type": "string"
    }
  }
}
