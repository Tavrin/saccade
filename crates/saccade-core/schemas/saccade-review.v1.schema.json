{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-review.v1.schema.json",
  "type": "object",
  "required": [
    "schema",
    "dry_run",
    "profile",
    "entries",
    "totals",
    "calls_used",
    "budget_calls",
    "max_gemini",
    "estimated_cost_usd",
    "never_final"
  ],
  "properties": {
    "schema": {
      "const": "saccade-review.v1"
    },
    "dry_run": {
      "type": "boolean"
    },
    "profile": {
      "type": "object"
    },
    "never_final": {
      "const": true
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entry",
          "status",
          "path",
          "judges",
          "agreement",
          "strong_proposal",
          "answer",
          "inbox",
          "vote_path",
          "evidence_hash"
        ],
        "properties": {
          "entry": {
            "type": "string"
          },
          "status": {
            "enum": [
              "proposal",
              "needs_human",
              "deterministic"
            ]
          },
          "path": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "judges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "provider",
                "model",
                "answer",
                "prob",
                "latency_ms",
                "attempts",
                "evidence_hash"
              ],
              "properties": {
                "provider": {
                  "enum": [
                    "jev",
                    "gemini"
                  ]
                },
                "model": {
                  "type": "string"
                },
                "answered_model": {
                  "type": "string"
                },
                "answer": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "prob": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "confidence": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "latency_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "attempts": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "evidence_hash": {
                  "type": "string"
                }
              }
            }
          },
          "agreement": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "strong_proposal": {
            "type": "boolean"
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "inbox": {
            "type": [
              "object",
              "null"
            ]
          },
          "vote_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_hash": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "totals": {
      "type": "object"
    },
    "calls_used": {
      "type": "integer",
      "minimum": 0
    },
    "budget_calls": {
      "type": "integer",
      "minimum": 0
    },
    "max_gemini": {
      "type": "integer",
      "minimum": 0
    },
    "estimated_cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  }
}
