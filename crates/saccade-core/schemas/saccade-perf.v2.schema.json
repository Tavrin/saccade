{
  "$defs": {
    "CapturePerf": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/PerfContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "counters": {
          "additionalProperties": {
            "additionalProperties": {
              "format": "double",
              "type": "number"
            },
            "type": "object"
          },
          "type": "object"
        },
        "frame": {
          "$ref": "#/$defs/Frame"
        },
        "kind": {
          "const": "measurement",
          "type": [
            "string",
            "null"
          ]
        },
        "schema": {
          "const": "saccade-perf.v2",
          "type": "string"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/Term"
          },
          "type": "array"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "unit",
        "frame",
        "terms",
        "counters",
        "kind"
      ],
      "type": "object"
    },
    "Comparability": {
      "enum": [
        "qualified",
        "rejected",
        "unknown"
      ],
      "type": "string"
    },
    "Digest": {
      "description": "Validated lowercase SHA-256 identity or content hash.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Frame": {
      "additionalProperties": false,
      "properties": {
        "samples": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stat": {
          "type": "string"
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "value",
        "samples",
        "stat"
      ],
      "type": "object"
    },
    "Kind": {
      "enum": [
        "pass",
        "gap",
        "scope"
      ],
      "type": "string"
    },
    "PerfContext": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "description": "joint_partition means terms account for this frame's measured window.\nindependent_statistics never supplies an additive frame remainder.",
          "type": "string"
        },
        "attribution_coverage": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "capture_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "configuration_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "hardware": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "measurement": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "producer": {
          "type": "string"
        },
        "producer_version": {
          "type": "string"
        },
        "qualification": {
          "$ref": "#/$defs/Qualification"
        },
        "quantum_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "raw_samples": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "type": "array"
        },
        "sample_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "timer": {
          "type": [
            "string",
            "null"
          ]
        },
        "unavailable_terms": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnavailableTerm"
          },
          "type": "array"
        },
        "unresolved_remainder_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "raw_samples",
        "hardware",
        "aggregation",
        "producer",
        "producer_version",
        "qualification"
      ],
      "type": "object"
    },
    "PerfNoise": {
      "additionalProperties": false,
      "properties": {
        "comparability": {
          "$ref": "#/$defs/Comparability",
          "default": "unknown"
        },
        "context_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "frame": {
          "format": "double",
          "type": "number"
        },
        "min_delta_ms": {
          "default": 0.05,
          "format": "double",
          "type": "number"
        },
        "min_delta_pct": {
          "default": 0.5,
          "description": "Percentage of the baseline frame, shared by frame and term thresholds.",
          "format": "double",
          "type": "number"
        },
        "resolution_ms": {
          "default": null,
          "description": "Estimated timer quantum, or an explicit override, in ms. None means unknown.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "resolution_ticks": {
          "default": 2,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "terms": {
          "additionalProperties": {
            "format": "double",
            "type": "number"
          },
          "default": {},
          "type": "object"
        },
        "timer": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "frame"
      ],
      "type": "object"
    },
    "PerformanceNoiseRecord": {
      "additionalProperties": false,
      "properties": {
        "capture_provenance": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "description": "Declared binary and source identities for each measured repeat.",
          "type": "object"
        },
        "comparability": {
          "$ref": "#/$defs/Comparability"
        },
        "kind": {
          "const": "performance_noise",
          "type": "string"
        },
        "perf_noise": {
          "$ref": "#/$defs/PerfNoise"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schema": {
          "const": "saccade-perf.v2",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "type": "array"
        },
        "unit": {
          "const": "ms",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "kind",
        "unit",
        "perf_noise",
        "comparability",
        "sources",
        "reasons"
      ],
      "type": "object"
    },
    "Qualification": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "additionalProperties": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "description": "Missing checks remain unknown; matching false checks reject both sides.",
          "type": "object"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rule": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Comparability"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "rule",
        "version",
        "checks",
        "reasons"
      ],
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "hash": {
          "$ref": "#/$defs/Digest"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "hash"
      ],
      "type": "object"
    },
    "Spread": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "format": "double",
          "type": "number"
        },
        "min": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "type": "object"
    },
    "Term": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "label": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "parent": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "spread": {
          "anyOf": [
            {
              "$ref": "#/$defs/Spread"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "value"
      ],
      "type": "object"
    },
    "UnavailableTerm": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "upper_bound_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-perf.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/CapturePerf"
    },
    {
      "$ref": "#/$defs/PerformanceNoiseRecord"
    }
  ],
  "title": "PerfDocument"
}
