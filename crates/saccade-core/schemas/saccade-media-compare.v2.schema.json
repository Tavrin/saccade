{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-media-compare.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capture_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "metrics": {
      "type": "object"
    },
    "ppd": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "reference_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-media-compare.v2"
    },
    "source_refs": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "reference_sha256",
    "capture_sha256",
    "metrics",
    "ppd",
    "report_id",
    "source_refs"
  ],
  "type": "object"
}
