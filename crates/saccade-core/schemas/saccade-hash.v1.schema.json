{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-hash.v1.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "saccade-hash.v1"
    },
    "operation": {
      "const": "hash"
    },
    "verdict": {
      "enum": [
        "pass",
        "regression"
      ]
    },
    "counts": {
      "type": "object"
    },
    "preprocessing": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "encoded_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "dimensions": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "ahash": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "dhash": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "phash": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          }
        },
        "required": [
          "path",
          "encoded_sha256",
          "dimensions",
          "ahash",
          "dhash",
          "phash"
        ],
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "operation",
    "verdict",
    "counts",
    "preprocessing",
    "entries",
    "errors",
    "limitations"
  ],
  "additionalProperties": false
}
