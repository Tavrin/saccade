{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "description": "Frozen input artifact, relative to the manifest directory.",
      "properties": {
        "path": {
          "description": "Relative filename.",
          "type": "string"
        },
        "sha256": {
          "description": "Expected lowercase SHA-256 of the encoded bytes.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "description": "A candidate's ordered stages, all measured against the resized reference.",
      "properties": {
        "id": {
          "description": "Unique candidate name.",
          "type": "string"
        },
        "stages": {
          "description": "Processing order, for example Drupal then delivered Imgix image.",
          "items": {
            "$ref": "#/$defs/Stage"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "stages"
      ],
      "type": "object"
    },
    "Stage": {
      "additionalProperties": false,
      "description": "One externally encoded pipeline stage.",
      "properties": {
        "dimensions": {
          "description": "Expected decoded dimensions.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "encoder": {
          "description": "Encoder and version, including settings other than quality.",
          "type": "string"
        },
        "id": {
          "description": "Stable pipeline stage ID.",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/Artifact",
          "description": "Encoded output."
        },
        "pixel_policy": {
          "description": "Must be normalized_srgb_opaque; profile/orientation normalization is external.",
          "type": "string"
        },
        "quality": {
          "description": "Encoder-specific quality setting; no universal visibility interpretation.",
          "format": "double",
          "type": "number"
        },
        "subsampling": {
          "description": "Explicit subsampling, such as 4:4:4.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "encoder",
        "quality",
        "subsampling",
        "pixel_policy",
        "dimensions",
        "output"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-quality-sweep.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Frozen sweep policy and its externally produced candidates.",
  "properties": {
    "candidates": {
      "description": "Nonempty candidate list. Missing or malformed candidates prevent selection.",
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "type": "array"
    },
    "maximum_bytes": {
      "description": "Maximum bytes of the delivered stage.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "minimum_score": {
      "description": "Minimum cumulative SSIMULACRA2 score for every stage.",
      "format": "double",
      "type": "number"
    },
    "original": {
      "$ref": "#/$defs/Artifact",
      "description": "Immutable original; never rewritten by the sweep."
    },
    "reference": {
      "$ref": "#/$defs/Artifact",
      "description": "Orientation/profile-normalized, resized opaque sRGB reference."
    },
    "schema": {
      "description": "Must be saccade-quality-sweep.v1.",
      "type": "string"
    },
    "viewing_conditions": {
      "description": "Display, scale, viewing distance, background and review conditions.",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "original",
    "reference",
    "minimum_score",
    "maximum_bytes",
    "viewing_conditions",
    "candidates"
  ],
  "title": "Manifest",
  "type": "object"
}
