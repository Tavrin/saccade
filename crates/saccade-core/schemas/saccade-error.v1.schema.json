{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-error.v1.schema.json",
  "title": "saccade-error.v1",
  "description": "Printed on stdout, with the command's exit code, when a command run with --json (or --format json) fails.",
  "type": "object",
  "required": [
    "schema",
    "code",
    "message",
    "hint"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "saccade-error.v1"
    },
    "code": {
      "enum": [
        "usage",
        "io",
        "config",
        "unsafe_path",
        "not_empty_out_dir",
        "nothing_compared",
        "approve_mismatch",
        "invalid_media_input",
        "invalid_media_options",
        "request_too_large",
        "media_section_failed",
        "vision_unavailable",
        "model_integrity",
        "runtime_incompatible",
        "embedding_unavailable",
        "text_embedding_unavailable",
        "video_decode_unavailable",
        "video_decode_failed",
        "invalid_video_input",
        "index_mismatch",
        "media_fetch_unavailable",
        "media_fetch_failed",
        "invalid_json",
        "io_error",
        "invalid_vision_input",
        "gpu_unavailable",
        "description_unavailable",
        "analyzer_poisoned",
        "media_error"
      ]
    },
    "message": {
      "type": "string"
    },
    "hint": {
      "type": "string",
      "description": "Offending path or argument and how to repair it."
    }
  }
}
