{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-approve.v1.schema.json",
  "title": "saccade-approve.v1",
  "description": "CLI approval summary; exact decisions and unattested receipts are canonical evidence artifacts. Paths are relative by default.",
  "type": "object",
  "required": [
    "schema",
    "copied",
    "pruned"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "saccade-approve.v1"
    },
    "copied": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "pruned": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dry_run": {
      "type": "boolean"
    },
    "manifest": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "receipt": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
