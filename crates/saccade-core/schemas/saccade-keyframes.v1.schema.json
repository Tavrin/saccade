{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-keyframes.v1.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "saccade-keyframes.v1"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "duration_basis": {
      "type": "string"
    },
    "sample_fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "samples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_sample": {
            "type": "integer",
            "minimum": 0
          },
          "end_sample": {
            "type": "integer",
            "minimum": 1
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "keyframe": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "start_sample",
          "end_sample",
          "start_seconds",
          "end_seconds",
          "keyframe"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "keyframes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sample": {
            "type": "integer",
            "minimum": 0
          },
          "timestamp_seconds": {
            "type": "number",
            "minimum": 0
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "sample",
          "timestamp_seconds",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "duration_seconds",
    "duration_basis",
    "sample_fps",
    "samples",
    "shots",
    "keyframes",
    "provenance"
  ],
  "additionalProperties": false
}
