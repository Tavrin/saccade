{
  "$defs": {
    "Arm": {
      "properties": {
        "combined_verdict": {
          "type": "string"
        },
        "config_differs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "excluded_repeats": {
          "default": [],
          "description": "Repeats excluded before measurement, with a specific reason.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "flag": {
          "type": "string"
        },
        "frame_change": {
          "$ref": "#/$defs/FrameChange",
          "default": "unknown"
        },
        "frame_delta": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "image_effect": {
          "$ref": "#/$defs/ImageEffect",
          "default": "unknown"
        },
        "image_verdict": {
          "type": "string"
        },
        "intended_keys": {
          "default": [],
          "description": "Intended-variable patterns for this arm.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "intended_variables": {
          "default": [],
          "description": "Intended keys and observed values, distinct from undeclared configuration differences.",
          "items": {
            "$ref": "#/$defs/MetaDiff"
          },
          "type": "array"
        },
        "label": {
          "type": "string"
        },
        "next_actions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "no_effect": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "perf_diff": {
          "anyOf": [
            {
              "$ref": "#/$defs/PerfDiff"
            },
            {
              "type": "null"
            }
          ]
        },
        "perf_errors": {
          "items": {
            "$ref": "#/$defs/PerfError"
          },
          "type": "array"
        },
        "perf_only": {
          "type": "boolean"
        },
        "repeat_stability": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepeatStability"
            },
            {
              "type": "null"
            }
          ]
        },
        "repeats": {
          "default": [],
          "description": "Complete captures used for this arm, in stable order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "report_html": {
          "type": "string"
        },
        "top_deltas": {
          "items": {
            "$ref": "#/$defs/TermDiff"
          },
          "type": "array"
        },
        "validity_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "label",
        "path",
        "image_verdict",
        "top_deltas",
        "config_differs",
        "no_effect",
        "perf_only",
        "flag",
        "combined_verdict",
        "errors",
        "perf_errors",
        "report_html"
      ],
      "type": "object"
    },
    "Assignment": {
      "additionalProperties": false,
      "description": "Frozen assignment for one independently acquired matched run pair.",
      "properties": {
        "id": {
          "description": "Stable run pair ID, declared before acquisition.",
          "type": "string"
        },
        "order": {
          "description": "ab or ba, the actual acquisition order to control/report order bias.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "order"
      ],
      "type": "object"
    },
    "Attribution": {
      "enum": [
        "complete",
        "partial",
        "inconsistent",
        "unavailable"
      ],
      "type": "string"
    },
    "ClockRange": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "format": "double",
          "type": "number"
        },
        "median": {
          "format": "double",
          "type": "number"
        },
        "min": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "min",
        "median",
        "max"
      ],
      "type": "object"
    },
    "ClockWindow": {
      "additionalProperties": false,
      "properties": {
        "core_mhz": {
          "$ref": "#/$defs/ClockRange"
        },
        "expected_frames": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "memory_mhz": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClockRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "observed_frames": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "query_failures": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sample_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stabilized": {
          "type": "boolean"
        },
        "throttle_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "core_mhz",
        "sample_count",
        "expected_frames",
        "observed_frames",
        "query_failures",
        "stabilized"
      ],
      "type": "object"
    },
    "Comparability": {
      "enum": [
        "qualified",
        "rejected",
        "unknown"
      ],
      "type": "string"
    },
    "Convergence": {
      "properties": {
        "coefficient_of_variation": {
          "format": "double",
          "type": "number"
        },
        "converged": {
          "type": "boolean"
        },
        "evaluated_range": {
          "items": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "relative_mean_change": {
          "format": "double",
          "type": "number"
        },
        "relative_slope_per_iteration": {
          "format": "double",
          "type": "number"
        },
        "samples": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "window_means_ms": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "policy",
        "samples",
        "evaluated_range",
        "window_means_ms",
        "relative_mean_change",
        "coefficient_of_variation",
        "relative_slope_per_iteration",
        "converged"
      ],
      "type": "object"
    },
    "CounterDiff": {
      "properties": {
        "after": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "before": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "beyond_noise": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "delta": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "delta_pct": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "noise_floor": {
          "description": "Raw repeat range in ms.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "noise_threshold": {
          "default": null,
          "description": "Effective threshold: max(k × range, ticks × quantum, absolute/relative minimum).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "description": "paired, appeared, disappeared, or not_comparable.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "type": "object"
    },
    "Delta": {
      "properties": {
        "after": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "before": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "beyond_noise": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "delta": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "delta_pct": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "noise_floor": {
          "description": "Raw repeat range in ms.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "noise_threshold": {
          "default": null,
          "description": "Effective threshold: max(k × range, ticks × quantum, absolute/relative minimum).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "description": "paired, appeared, disappeared, or not_comparable.",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "Digest": {
      "description": "Validated lowercase SHA-256 identity or content hash.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Effect": {
      "description": "Reproducible robust frame effect, separate from aggregate and noise evidence.",
      "properties": {
        "confidence": {
          "description": "Prespecified confidence level.",
          "format": "double",
          "type": "number"
        },
        "degenerate": {
          "description": "Equal-valued bootstrap effect distribution; cannot support a new verdict.",
          "type": "boolean"
        },
        "delta_ms": {
          "description": "Candidate minus reference paired timing effect, ms.",
          "format": "double",
          "type": "number"
        },
        "delta_pct": {
          "description": "100×(exp(HL(log(after)-log(before)))-1).",
          "format": "double",
          "type": "number"
        },
        "estimator": {
          "description": "paired_hodges_lehmann_walsh; pseudomedian shift, not population median.",
          "type": "string"
        },
        "interval_method": {
          "description": "percentile bootstrap with whole run-pair resampling and linear quantiles.",
          "type": "string"
        },
        "interval_ms": {
          "description": "Paired percentile interval, ms.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "interval_pct": {
          "description": "Transformed interval on the same paired log-ratios.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "limits": {
          "description": "Numerical and sampling limits.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pairs": {
          "description": "Number of complete independently acquired run pairs.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "plan_sha256": {
          "$ref": "#/$defs/Digest",
          "description": "Canonical plan identity."
        },
        "resamples": {
          "description": "Fixed resample count.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "samples": {
          "$ref": "#/$defs/Samples",
          "description": "Complete fixed plan and raw observations, retained for independent replay."
        },
        "samples_sha256": {
          "$ref": "#/$defs/Digest",
          "description": "Complete series identity, including raw observations and aggregate pins."
        },
        "seed": {
          "description": "Reproducible generator seed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "estimator",
        "interval_method",
        "delta_ms",
        "interval_ms",
        "delta_pct",
        "interval_pct",
        "confidence",
        "pairs",
        "resamples",
        "seed",
        "plan_sha256",
        "samples_sha256",
        "samples",
        "degenerate",
        "limits"
      ],
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "iterations_ms": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        }
      },
      "required": [
        "policy",
        "iterations_ms"
      ],
      "type": "object"
    },
    "FrameChange": {
      "enum": [
        "faster",
        "slower",
        "within_measured_noise",
        "unknown"
      ],
      "type": "string"
    },
    "GpuClock": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string"
        },
        "power_state": {
          "description": "Explicit producer power state, e.g. `ac-performance`. Unknown is absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "schema": {
          "type": "string"
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/ClockWindow"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "device_id",
        "windows"
      ],
      "type": "object"
    },
    "ImageEffect": {
      "enum": [
        "identical",
        "changed",
        "unknown"
      ],
      "type": "string"
    },
    "Kind": {
      "enum": [
        "pass",
        "gap",
        "scope"
      ],
      "type": "string"
    },
    "Materiality": {
      "properties": {
        "blocks_no_effect": {
          "type": "boolean"
        },
        "floor_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unexplained_upper_bound_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "blocks_no_effect",
        "reasons"
      ],
      "type": "object"
    },
    "MetaDiff": {
      "description": "One metadata key whose value differs between the two sides.",
      "properties": {
        "baseline": {
          "description": "Value on the baseline side, or `<absent>`.",
          "type": "string"
        },
        "capture": {
          "description": "Value on the capture side, or `<absent>`.",
          "type": "string"
        },
        "key": {
          "description": "Sidecar key.",
          "type": "string"
        }
      },
      "required": [
        "key",
        "baseline",
        "capture"
      ],
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "description": "One matched run observation, not an arbitrary pair of correlated frames.",
      "properties": {
        "after_ms": {
          "description": "Candidate run timing in milliseconds, strictly positive and finite.",
          "format": "double",
          "type": "number"
        },
        "before_ms": {
          "description": "Reference run timing in milliseconds, strictly positive and finite.",
          "format": "double",
          "type": "number"
        },
        "order": {
          "description": "Actual acquisition order, matching its predeclared assignment.",
          "type": "string"
        },
        "pair_id": {
          "description": "Exactly the planned pair ID.",
          "type": "string"
        }
      },
      "required": [
        "pair_id",
        "order",
        "before_ms",
        "after_ms"
      ],
      "type": "object"
    },
    "PerfContext": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "description": "joint_partition means terms account for this frame's measured window.\nindependent_statistics never supplies an additive frame remainder.",
          "type": "string"
        },
        "attribution_coverage": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "capture_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "configuration_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "hardware": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "measurement": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "producer": {
          "type": "string"
        },
        "producer_version": {
          "type": "string"
        },
        "qualification": {
          "$ref": "#/$defs/Qualification"
        },
        "quantum_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "raw_samples": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "type": "array"
        },
        "sample_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "timer": {
          "type": [
            "string",
            "null"
          ]
        },
        "unavailable_terms": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnavailableTerm"
          },
          "type": "array"
        },
        "unresolved_remainder_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "raw_samples",
        "hardware",
        "aggregation",
        "producer",
        "producer_version",
        "qualification"
      ],
      "type": "object"
    },
    "PerfDiff": {
      "properties": {
        "attribution": {
          "$ref": "#/$defs/Attribution",
          "default": "unavailable"
        },
        "comparability": {
          "$ref": "#/$defs/Comparability",
          "default": "unknown"
        },
        "context_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/PerfContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context_before": {
          "anyOf": [
            {
              "$ref": "#/$defs/PerfContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Producer evidence is retained in analytical reports, including its hashes."
        },
        "frame": {
          "$ref": "#/$defs/Delta"
        },
        "frame_change": {
          "$ref": "#/$defs/FrameChange",
          "default": "unknown"
        },
        "gpu_clock_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuClock"
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu_clock_before": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuClock"
            },
            {
              "type": "null"
            }
          ]
        },
        "history_identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "description": "Capture-side comparison identity, including the timing statistic. Historical absence is unknown."
        },
        "materiality": {
          "$ref": "#/$defs/Materiality",
          "default": {
            "blocks_no_effect": false,
            "floor_ms": null,
            "reasons": [],
            "unexplained_upper_bound_ms": null
          }
        },
        "min_delta_ms": {
          "default": 0.05,
          "format": "double",
          "type": "number"
        },
        "min_delta_pct": {
          "default": 0.5,
          "format": "double",
          "type": "number"
        },
        "minimum_delta_ms": {
          "default": 0.0,
          "description": "max(min_delta_ms, baseline frame × min_delta_pct / 100).",
          "format": "double",
          "type": "number"
        },
        "noise_comparability": {
          "$ref": "#/$defs/Comparability",
          "default": "unknown"
        },
        "noise_k": {
          "format": "double",
          "type": "number"
        },
        "policy_sources": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Effective policy sources: explicit options, repeat calibration or defaults.",
          "type": "object"
        },
        "qualification_reason_codes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "type": "array"
        },
        "qualification_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resolution_ms": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "resolution_ticks": {
          "default": 2,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "robust_effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Effect"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional fixed-plan paired frame estimate; historical absence remains unavailable."
        },
        "schema": {
          "type": "string"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/TermDiff"
          },
          "type": "array"
        },
        "unattributed_after": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "unattributed_before": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "warmup_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/Convergence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warmup_before": {
          "anyOf": [
            {
              "$ref": "#/$defs/Convergence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "unit",
        "noise_k",
        "frame",
        "terms",
        "warnings"
      ],
      "type": "object"
    },
    "PerfError": {
      "properties": {
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "message"
      ],
      "type": "object"
    },
    "PerfNoise": {
