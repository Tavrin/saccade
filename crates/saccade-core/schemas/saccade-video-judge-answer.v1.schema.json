{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tavrin.github.io/saccade/schemas/saccade-video-judge-answer.v1.schema.json",
  "title": "Advisory frame video answer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_hash",
    "outcome",
    "scores",
    "preferred"
  ],
  "properties": {
    "request_hash": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "scored",
        "abstain"
      ]
    },
    "scores": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "score",
          "cues"
        ],
        "properties": {
          "slot": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ]
          },
          "score": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 1,
                "maximum": 10
              },
              {
                "type": "null"
              }
            ]
          },
          "cues": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cue",
                "state",
                "timestamps_s"
              ],
              "properties": {
                "cue": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "present",
                    "absent",
                    "unknown"
                  ]
                },
                "timestamps_s": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "criteria": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "score"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "score": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "forbidden": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "condition",
                "state"
              ],
              "properties": {
                "condition": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "present",
                    "absent",
                    "unknown"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "preferred": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "tie",
        "abstain",
        "single"
      ]
    }
  }
}
