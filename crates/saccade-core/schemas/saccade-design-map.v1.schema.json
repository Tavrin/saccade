{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saccade-design-map.v1",
  "title": "saccade-design-map.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "saccade-design-map.v1"
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "file_key": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "test_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "selector": {
            "type": [
              "string",
              "null"
            ]
          },
          "viewport": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 8,
              "maximum": 16384
            },
            "minItems": 2,
            "maxItems": 2
          },
          "css_tokens": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "file_key",
          "node_id",
          "viewport"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "frames"
  ],
  "additionalProperties": false
}
