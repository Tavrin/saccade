{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-media-index-query.v1.schema.json",
  "title": "Compact media index query",
  "type": "object",
  "properties": {
    "schema": {
      "const": "saccade-media-index-query.v1"
    },
    "query_kind": {
      "type": "string"
    },
    "model_contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "calibration": {
      "const": "uncalibrated"
    },
    "hits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "row": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 4096
              },
              "encoded_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "encoded_sha256"
            ],
            "additionalProperties": false
          },
          "row_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999
          },
          "cosine": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "band": {
            "type": "null"
          }
        },
        "required": [
          "row",
          "row_index",
          "cosine",
          "band"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "query_kind",
    "model_contract_sha256",
    "calibration",
    "hits"
  ],
  "additionalProperties": false
}
