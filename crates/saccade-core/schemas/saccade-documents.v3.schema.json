{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-documents.v3.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "counts": {
      "type": "object"
    },
    "inputs": {
      "type": "object"
    },
    "limitations": {
      "type": "array"
    },
    "operation": {
      "const": "documents_compare"
    },
    "pages": {
      "items": {
        "properties": {
          "page": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "status": {
            "enum": [
              "pass",
              "regression",
              "new",
              "missing",
              "error"
            ]
          },
          "reference_page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 500
          },
          "candidate_page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 500
          }
        },
        "type": "object",
        "required": [
          "page",
          "reference_page",
          "candidate_page",
          "status"
        ]
      },
      "maxItems": 1000,
      "type": "array"
    },
    "rendering": {
      "type": "object"
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-documents.v3"
    },
    "source_refs": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "verdict": {
      "enum": [
        "pass",
        "regression"
      ]
    },
    "page_map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "declared",
            "single_page"
          ]
        },
        "map": {
          "$ref": "#/$defs/map"
        }
      },
      "required": [
        "source",
        "map"
      ]
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "encoded_bytes": {
          "const": 67108864
        },
        "memory_bytes": {
          "const": 536870912
        },
        "wall_time_ms": {
          "const": 15000
        },
        "cpu_seconds": {
          "const": 10
        },
        "pages": {
          "const": 500
        },
        "dimension": {
          "const": 16384
        },
        "pixels": {
          "const": 16777216
        },
        "object_depth": {
          "const": 64
        },
        "objects": {
          "const": 100000
        },
        "decompressed_bytes": {
          "const": 67108864
        },
        "operation_wall_time_ms": {
          "const": 60000
        },
        "operation_memory_bytes": {
          "const": 1073741824
        },
        "operation_cpu_seconds": {
          "const": 60
        },
        "total_pixels": {
          "const": 8388608
        },
        "comparison_pixels": {
          "const": 1048576
        },
        "output_bytes": {
          "const": 67108864
        }
      },
      "required": [
        "encoded_bytes",
        "memory_bytes",
        "wall_time_ms",
        "cpu_seconds",
        "pages",
        "dimension",
        "pixels",
        "object_depth",
        "objects",
        "decompressed_bytes"
      ]
    }
  },
  "required": [
    "schema",
    "operation",
    "verdict",
    "counts",
    "inputs",
    "rendering",
    "pages",
    "limitations",
    "report_id",
    "source_refs",
    "caps",
    "page_map"
  ],
  "type": "object",
  "title": "saccade-documents.v3",
  "$defs": {
    "map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "saccade-page-map.v1"
        },
        "reference_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reference": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 500
              },
              "candidate": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 500
              }
            },
            "required": [
              "reference",
              "candidate"
            ],
            "not": {
              "properties": {
                "reference": {
                  "type": "null"
                },
                "candidate": {
                  "type": "null"
                }
              }
            }
          }
        }
      },
      "required": [
        "schema",
        "reference_sha256",
        "candidate_sha256",
        "pairs"
      ]
    }
  }
}
