{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-review-board-packet.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "choices": {
      "const": [
        "first",
        "second",
        "tie",
        "unsure"
      ]
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_hash": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "first": {
            "type": "string"
          },
          "id": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "second": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "evidence_hash",
          "first",
          "second"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array"
    },
    "question": {
      "type": "string"
    },
    "rater_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-review-board-packet.v1"
    },
    "trial_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "trial_id",
    "rater_key",
    "question",
    "choices",
    "items"
  ],
  "title": "Blind board rater packet",
  "type": "object"
}
