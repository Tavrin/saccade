{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-document-text.v1.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "saccade-document-text.v1"
    },
    "operation": {
      "const": "text"
    },
    "verdict": {
      "enum": [
        "pass",
        "regression",
        "unknown"
      ]
    },
    "counts": {
      "type": "object"
    },
    "comparison": {
      "type": "object"
    },
    "documents": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "limitations": {
      "type": "array"
    }
  },
  "required": [
    "schema",
    "operation",
    "verdict",
    "counts",
    "comparison",
    "documents",
    "limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "document": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "saccade-document-ocr.v1"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "markdown": {
                "type": "string"
              },
              "dimensions": {
                "type": [
                  "array",
                  "null"
                ]
              },
              "observations": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "required": [
              "index",
              "markdown",
              "dimensions",
              "observations"
            ],
            "additionalProperties": false
          }
        },
        "text": {
          "type": "string"
        },
        "provenance": {
          "type": "object"
        }
      },
      "required": [
        "schema",
        "pages",
        "text",
        "provenance"
      ],
      "additionalProperties": false
    }
  }
}
