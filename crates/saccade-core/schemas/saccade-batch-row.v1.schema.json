{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-batch-row.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "duplicate_basename": {
      "type": "boolean"
    },
    "id": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "occurrence": {
      "minimum": 0,
      "type": "integer"
    },
    "path": {
      "type": "string"
    },
    "probe": {
      "type": "object"
    },
    "reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "reference_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "const": "saccade-batch-row.v1"
    },
    "sections": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "result": {},
          "status": {
            "enum": [
              "ok",
              "partial",
              "skipped",
              "timed-out"
            ]
          }
        },
        "required": [
          "command",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "ok",
        "corrupt",
        "unsupported",
        "duplicate-basename",
        "timed-out",
        "partial",
        "skipped"
      ]
    },
    "thumbnail": {
      "type": [
        "string",
        "null"
      ]
    },
    "timeout_ms": {
      "maximum": 300000,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "id",
    "path",
    "content_sha256",
    "reference",
    "reference_sha256",
    "duplicate_basename",
    "status",
    "sections",
    "thumbnail",
    "occurrence"
  ],
  "title": "Durable batch item receipt",
  "type": "object"
}
