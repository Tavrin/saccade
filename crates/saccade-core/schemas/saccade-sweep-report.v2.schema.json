{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-sweep-report.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capture_failures": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "groups": {
      "additionalProperties": {
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "type": "object"
    },
    "report": {
      "type": "string"
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-sweep-report.v2"
    },
    "source_refs": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "totals": {
      "type": "object"
    },
    "verdict": {
      "enum": [
        "pass",
        "regression"
      ]
    }
  },
  "required": [
    "schema",
    "verdict",
    "groups",
    "capture_failures",
    "totals",
    "report",
    "report_id",
    "source_refs"
  ],
  "title": "saccade-sweep-report.v1",
  "type": "object"
}
