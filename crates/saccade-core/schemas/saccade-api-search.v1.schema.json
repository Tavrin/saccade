{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-api-search.v1.schema.json",
  "type": "object",
  "properties": {
    "index": {
      "type": "string"
    },
    "image": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "bytes_base64": {
              "type": "string"
            }
          },
          "required": [
            "bytes_base64"
          ],
          "additionalProperties": false
        }
      ]
    },
    "text": {
      "type": "string"
    },
    "top": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "index"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "image"
      ],
      "not": {
        "required": [
          "text"
        ]
      }
    },
    {
      "required": [
        "text"
      ],
      "not": {
        "required": [
          "image"
        ]
      }
    }
  ]
}
