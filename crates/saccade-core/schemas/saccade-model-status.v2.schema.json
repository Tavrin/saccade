{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-model-status.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "models",
        "unavailable_selections"
      ]
    },
    {
      "required": [
        "model",
        "status",
        "artifact_count",
        "source_parity"
      ]
    }
  ],
  "properties": {
    "artifact_count": {
      "minimum": 1,
      "type": "integer"
    },
    "contracts": {
      "type": "object"
    },
    "model": {
      "type": "object"
    },
    "models": {
      "type": "array"
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-model-status.v2",
      "type": "string"
    },
    "source_parity": {
      "type": "boolean"
    },
    "source_refs": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "status": {
      "const": "cached_verified"
    },
    "unavailable_selections": {
      "type": "array"
    }
  },
  "required": [
    "schema",
    "report_id",
    "source_refs"
  ],
  "title": "saccade-model-status.v1",
  "type": "object"
}
