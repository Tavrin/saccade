{
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-general-result.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "data": {
      "type": "object"
    },
    "mode": {
      "type": "string"
    },
    "next_actions": {
      "type": "array"
    },
    "report_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "saccade-general-result.v2"
    },
    "source_refs": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "verdict": {
      "enum": [
        "pass",
        "regression",
        "unknown"
      ]
    }
  },
  "required": [
    "schema",
    "mode",
    "verdict",
    "data",
    "artifacts",
    "next_actions",
    "report_id",
    "source_refs"
  ],
  "title": "saccade-general-result.v1",
  "type": "object"
}
