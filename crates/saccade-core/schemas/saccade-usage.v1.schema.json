{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-usage.v1.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "saccade-usage.v1"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "target",
          "status"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "status": {
            "enum": [
              "matched",
              "no_match",
              "failed"
            ]
          },
          "transform": {
            "type": "array",
            "minItems": 9,
            "maxItems": 9,
            "items": {
              "type": "number"
            }
          },
          "crop_rectangle": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "source_sha256",
    "targets",
    "limitations"
  ],
  "additionalProperties": false
}
