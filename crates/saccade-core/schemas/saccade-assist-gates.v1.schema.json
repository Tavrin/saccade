{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-assist-gates.v1.schema.json",
  "title": "saccade-assist-gates.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "saccade-assist-gates.v1"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "const": "PASS"
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "source_before",
        "test_counts",
        "binary",
        "binary_hash",
        "toolchain",
        "features",
        "build_env"
      ],
      "properties": {
        "source_before": {
          "type": "string"
        },
        "test_counts": {
          "type": "object"
        },
        "binary": {
          "type": "string"
        },
        "binary_hash": {
          "type": "string"
        },
        "toolchain": {
          "type": "string"
        },
        "features": {
          "type": "string"
        },
        "build_env": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "source_hash",
    "gates",
    "execution"
  ],
  "additionalProperties": false
}
