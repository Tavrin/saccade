{
  "$defs": {
    "Case": {
      "additionalProperties": false,
      "description": "A declared variant; absent files and absent comparisons are valid declarations.",
      "properties": {
        "anchor_comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/MeasurementRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current capture relative to the approved anchor."
        },
        "approved_anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-approved reference declaration; passing never populates it."
        },
        "approved_at_unix": {
          "description": "Explicit approval time, if known; never inferred from a report timestamp.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Expected baseline, including a path/hash for an unavailable input if known."
        },
        "capture": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Expected current capture. None means explicitly absent on this side."
        },
        "case_id": {
          "description": "Stable identity independent of paths.",
          "type": "string"
        },
        "last_good": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Most recent passing reference declaration; a separate role from approval."
        },
        "last_good_comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/MeasurementRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Current capture relative to last-good."
        },
        "latest": {
          "anyOf": [
            {
              "$ref": "#/$defs/MeasurementRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Latest baseline-relative comparison."
        },
        "refusal": {
          "description": "Optional producer refusal reason (no semantic inference).",
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "description": "Whether incomplete coverage fails the coverage gate.",
          "type": "boolean"
        },
        "variants": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "One value for every declared axis.",
          "type": "object"
        }
      },
      "required": [
        "case_id",
        "variants",
        "required"
      ],
      "type": "object"
    },
    "FileRef": {
      "additionalProperties": false,
      "description": "An encoded input recorded by path and content hash, as in Lane C anchors.",
      "properties": {
        "path": {
          "description": "Path relative to the output manifest (not the declaration input).",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 of encoded bytes.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "MeasurementRef": {
      "additionalProperties": false,
      "description": "One measured entry resolved through the existing manifest report-ID index.",
      "properties": {
        "entry": {
          "description": "Exact comparison entry name; never guessed from case ID or filename.",
          "type": "string"
        },
        "report_id": {
          "description": "Content-addressed report identity.",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "entry"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/Tavrin/saccade/crates/saccade-core/schemas/saccade-manifest.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval": {
      "additionalProperties": false,
      "properties": {
        "approved_anchor": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_good": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string"
        },
        "state": {
          "enum": [
            "none",
            "anchor_declared"
          ]
        }
      },
      "required": [
        "state",
        "approved_anchor",
        "last_good",
        "note"
      ],
      "type": "object"
    },
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "also_at": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "media_type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "report_id": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "role": {
            "enum": [
              "report",
              "document",
              "page",
              "image",
              "index",
              "other"
            ]
          },
          "schema": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "role",
          "media_type",
          "also_at"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "axes": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "Allowed values of generic axes such as viewport, language, theme or tier.",
      "type": "object"
    },
    "cases": {
      "description": "All expected cases, including variants absent on both sides.",
      "items": {
        "$ref": "#/$defs/Case"
      },
      "type": "array"
    },
    "completion": {
      "const": "recorded"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "duplicate_files": {
          "minimum": 0,
          "type": "integer"
        },
        "duplicate_rows": {
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "minimum": 0,
          "type": "integer"
        },
        "indexed_rows": {
          "minimum": 0,
          "type": "integer"
        },
        "reports": {
          "minimum": 0,
          "type": "integer"
        },
        "skipped_symlinks": {
          "minimum": 0,
          "type": "integer"
        },
        "unique_artifacts": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "files",
        "unique_artifacts",
        "duplicate_files",
        "reports",
        "indexed_rows",
        "duplicate_rows",
        "skipped_symlinks"
      ],
      "type": "object"
    },
    "kind": {
      "const": "report_directory"
    },
    "reports": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "also_at": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "indexed_rows": {
            "minimum": 0,
            "type": "integer"
          },
          "local": {
            "type": "boolean"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "report_id": {
            "type": "string"
          },
          "schema": {},
          "sha256": {
            "oneOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "verdict_class": {}
        },
        "required": [
          "report_id",
          "local",
          "path",
          "sha256",
          "also_at",
          "indexed_rows",
          "source_refs"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "const": "saccade-manifest.v2"
    }
  },
  "required": [
    "schema",
    "kind",
    "completion",
    "approval",
    "counts",
    "artifacts",
    "reports",
    "axes",
    "cases"
  ],
  "title": "Declared-case output manifest (v2 successor)",
  "type": "object"
}
