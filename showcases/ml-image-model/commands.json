[
  {
    "name": "compare",
    "args": [
      "compare",
      "baseline",
      "capture",
      "--config",
      "saccade.toml"
    ],
    "out": "compare",
    "exit": 1
  },
  {
    "name": "explain",
    "args": [
      "inspect",
      "evidence",
      "@REPORTS@/compare/saccade-report.v1.json"
    ],
    "out": "explain",
    "exit": 0
  },
  {
    "name": "export",
    "args": [
      "inspect",
      "export",
      "@REPORTS@/compare/saccade-report.v1.json",
      "--format",
      "markdown",
      "--out",
      "@REPORTS@/summary.md"
    ],
    "exit": 0
  }
]
