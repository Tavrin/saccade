{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/schemas/saccade-summary.v1.schema.json",
  "title": "saccade-summary.v1",
  "description": "Printed by `saccade summary --format json` and returned by the MCP summary tool.",
  "type": "object",
  "required": [
    "schema",
    "verdict",
    "regression",
    "mode",
    "labels",
    "totals",
    "failing",
    "failing_omitted",
    "paths"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "saccade-summary.v1"
    },
    "verdict": {
      "enum": [
        "pass",
        "regression"
      ]
    },
    "regression": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "regression",
        "identity"
      ]
    },
    "labels": {
      "type": "object",
      "required": [
        "baseline",
        "capture"
      ],
      "properties": {
        "baseline": {
          "type": "string"
        },
        "capture": {
          "type": "string"
        }
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "total",
        "pass",
        "fail",
        "new",
        "missing",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "failing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "metric",
          "value",
          "threshold"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "new",
              "missing",
              "error"
            ]
          },
          "metric": {
            "enum": [
              "mean",
              "p95",
              "p99",
              "max"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "threshold": {
            "type": "number"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "bit_identical": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "failing_regions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "config_differs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "class": {
            "type": [
              "string",
              "null"
            ],
            "description": "Diagnostics class (identical, noise, global_tone, local_structure, mixed, misaligned, broken_frame), null when diagnostics did not run."
          },
          "buffer": {
            "type": ["object", "null"],
            "description": "Numerical buffer statistics in depth units, degrees, pixels or changed fraction."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Deterministic plain-English description of the change."
          },
          "hotspots": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "failing_omitted": {
      "type": "integer",
      "minimum": 0
    },
    "paths": {
      "type": "object",
      "required": [
        "report_json",
        "report_dir"
      ],
      "properties": {
        "report_json": {
          "type": "string"
        },
        "report_dir": {
          "type": "string"
        },
        "index_html": {
          "type": [
            "string",
            "null"
          ]
        },
        "explain_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "explain_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "explain_md": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
