{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/flipdiff/schemas/flipdiff-calibration.v1.schema.json",
  "type": "object",
  "required": [
    "schema",
    "labelled_units",
    "judges",
    "human_ceiling",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "flipdiff-calibration.v1"
    },
    "labelled_units": {
      "type": "integer",
      "minimum": 0
    },
    "judges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "judge",
          "question",
          "accuracy",
          "agreement_with_humans",
          "ece",
          "reliability",
          "position_bias",
          "suggested_gate"
        ],
        "properties": {
          "ece": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "accuracy": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "reliability": {
            "type": "array"
          },
          "suggested_gate": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "human_ceiling": {
      "type": "array"
    }
  }
}
