{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/flipdiff/schemas/flipdiff-runs.v1.schema.json",
  "title": "flipdiff-runs.v1",
  "description": "The run overview: several runs (directories of images) compared with a reference run, image by image. Returned by `GET /api/runs` of `flipdiff serve`, written as flipdiff-runs.v1.json by `flipdiff runs`, printed by `flipdiff runs --json` and returned (without thumbnail or heatmap URLs, null fields left out) by the MCP tool `flipdiff_compare_runs`. While the server is still measuring, pending cells have status `pending` and `progress.complete` is false.",
  "type": "object",
  "required": [
    "schema",
    "tool_version",
    "ref",
    "runs",
    "config_differences",
    "images",
    "progress"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "flipdiff-runs.v1"
    },
    "tool_version": {
      "type": "string"
    },
    "ref": {
      "type": "object",
      "required": [
        "label",
        "path",
        "images"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "The shown path: relative to the archive root under `serve`, as given on the command line otherwise."
        },
        "images": {
          "type": "array",
          "description": "The reference's images, sorted by name; a manual pairing indexes into this list.",
          "items": {
            "$ref": "#/$defs/image_ref"
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "config_differences": {
      "type": "array",
      "description": "Run-level sidecar keys that differ between the runs, shown once instead of per image.",
      "items": {
        "type": "object",
        "required": [
          "key",
          "values"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "description": "One value per run, the reference first; the reference's value for a run that does not differ.",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "images": {
      "type": "array",
      "description": "The matrix: one row per image name, sorted by name.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "cells"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "ref_image": {
            "oneOf": [
              {
                "$ref": "#/$defs/image_ref"
              },
              {
                "type": "null"
              }
            ],
            "description": "Absent for an image only some run has."
          },
          "worst": {
            "type": [
              "number",
              "null"
            ],
            "description": "Largest mean FLIP of the row."
          },
          "cells": {
            "type": "array",
            "description": "One cell per run, in run order.",
            "items": {
              "$ref": "#/$defs/cell"
            }
          }
        }
      }
    },
    "progress": {
      "type": "object",
      "required": [
        "done",
        "total",
        "complete"
      ],
      "additionalProperties": false,
      "properties": {
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "image_ref": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "thumb": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "label",
        "path",
        "pairing",
        "images",
        "identical",
        "changed",
        "errors",
        "pending",
        "only_in_ref",
        "only_in_run",
        "name_matches",
        "mismatch",
        "no_visible_effect",
        "config_differs",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "pairing": {
          "enum": [
            "name",
            "position",
            "manual"
          ]
        },
        "images": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of images in the run."
        },
        "identical": {
          "type": "integer",
          "minimum": 0,
          "description": "Pairs whose decoded samples are bit-identical."
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0,
          "description": "Pairs that could not be compared (size mismatch, undecodable image)."
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "only_in_ref": {
          "type": "integer",
          "minimum": 0
        },
        "only_in_run": {
          "type": "integer",
          "minimum": 0
        },
        "name_matches": {
          "type": "integer",
          "minimum": 0,
          "description": "Reference file names the run also has, whatever the pairing."
        },
        "mismatch": {
          "type": "boolean",
          "description": "Few or no file names match (fewer than half of the smaller run's): the run probably needs another pairing."
        },
        "worst": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "name",
            "mean"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "mean": {
              "type": "number"
            }
          }
        },
        "no_visible_effect": {
          "type": "boolean",
          "description": "Every image is bit-identical to the reference's and none is missing or extra: the run changed nothing."
        },
        "config_differs": {
          "type": "array",
          "description": "Run-level sidecar keys that differ from the reference's.",
          "items": {
            "type": "string"
          }
        },
        "config_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_images": {
          "type": "array",
          "description": "The run's own images, listed only when `mismatch` (for manual pairing).",
          "items": {
            "$ref": "#/$defs/image_ref"
          }
        },
        "summary": {
          "type": "string",
          "description": "N identical · N changed (worst `name` mean) · N only-in-ref · N only-in-run · config differs: K keys"
        }
      }
    },
    "cell": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "identical",
            "changed",
            "error",
            "pending",
            "only_in_ref",
            "only_in_run",
            "absent"
          ]
        },
        "run_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "The run's image name when it is not the row's (position or manual pairing)."
        },
        "thumb": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "type": [
            "string",
            "null"
          ]
        },
        "metrics": {
          "type": [
            "object",
            "null"
          ],
          "description": "FLIP statistics of a changed pair, all in [0, 1].",
          "required": [
            "mean",
            "max",
            "p50",
            "p95",
            "p99",
            "frac_above_0_1",
            "frac_above_0_5",
            "width",
            "height"
          ],
          "properties": {
            "mean": { "type": ["number", "null"] },
            "max": { "type": ["number", "null"] },
            "p50": { "type": ["number", "null"] },
            "p95": { "type": ["number", "null"] },
            "p99": { "type": ["number", "null"] },
            "frac_above_0_1": { "type": ["number", "null"] },
            "frac_above_0_5": { "type": ["number", "null"] },
            "width": { "type": "integer" },
            "height": { "type": "integer" }
          }
        },
        "heat": {
          "type": [
            "string",
            "null"
          ],
          "description": "URL of the mini FLIP heatmap (served and static pages only)."
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
