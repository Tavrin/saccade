{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/schemas/saccade-result.v1.schema.json",
  "title": "saccade-result.v1",
  "description": "The lean result of `compare --json` / `identity --json` and of the MCP run tools. Floats carry 4 significant digits; paths are absolute. `--json=full` prints the whole saccade-report.v1 instead.",
  "type": "object",
  "required": [
    "schema",
    "verdict",
    "mode",
    "totals",
    "failing",
    "failing_omitted",
    "paths",
    "next_step"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "saccade-result.v1"
    },
    "verdict": {
      "enum": [
        "pass",
        "regression"
      ]
    },
    "mode": {
      "enum": [
        "regression",
        "identity"
      ]
    },
    "totals": {
      "type": "object",
      "required": [
        "total",
        "pass",
        "fail",
        "new",
        "missing",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "failing": {
      "type": "array",
      "description": "Entries that fail the run, worst first.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "metric",
          "value",
          "threshold"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "new",
              "missing",
              "error"
            ]
          },
          "metric": {
            "enum": [
              "mean",
              "p95",
              "p99",
              "max"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "threshold": {
            "type": "number"
          },
          "buffer": {
            "type": ["object", "null"],
            "description": "Numerical buffer kind, encoding, units, deciding value, threshold and per-kind stats; FLIP did not run."
          },
          "error": {
            "type": "string"
          },
          "config_differs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Metadata-sidecar keys that differ."
          },
          "failing_regions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "class": {
            "enum": [
              "identical",
              "noise",
              "global_tone",
              "local_structure",
              "mixed",
              "misaligned",
              "broken_frame"
            ],
            "description": "Kind of change found by the diagnostics engine (report entry diagnostics.class)."
          },
          "description": {
            "type": "string",
            "description": "Deterministic plain-English description of the change; states only causes the measurements support."
          },
          "perf": {
            "type": "string",
            "description": "Timing keys of both sidecars, for example `gpu_ms 4.85 -> 2.71 (-44%)`."
          },
          "hotspots": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "rect_px",
                "position",
                "share_of_total_error",
                "mean_flip",
                "max_flip"
              ],
              "additionalProperties": false,
              "properties": {
                "rect_px": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "position": {
                  "type": "string"
                },
                "share_of_total_error": {
                  "type": "number"
                },
                "mean_flip": {
                  "type": "number"
                },
                "max_flip": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "failing_omitted": {
      "type": "integer",
      "minimum": 0
    },
    "paths": {
      "type": "object",
      "required": [
        "report_json",
        "index_html",
        "explain_md"
      ],
      "additionalProperties": false,
      "properties": {
        "report_json": {
          "type": "string"
        },
        "index_html": {
          "type": [
            "string",
            "null"
          ]
        },
        "explain_md": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "next_step": {
      "type": "string"
    },
    "explain_error": {
      "type": "string",
      "description": "MCP only: why the explain pack could not be written."
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 5,
      "description": "Up to 5 report warnings (for example an all-black capture), as `name: text`."
    }
  }
}
