{
  "$defs": {
    "ClockRange": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "format": "double",
          "type": "number"
        },
        "median": {
          "format": "double",
          "type": "number"
        },
        "min": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "min",
        "median",
        "max"
      ],
      "type": "object"
    },
    "ClockWindow": {
      "additionalProperties": false,
      "properties": {
        "core_mhz": {
          "$ref": "#/$defs/ClockRange"
        },
        "expected_frames": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "memory_mhz": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClockRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "observed_frames": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "query_failures": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sample_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stabilized": {
          "type": "boolean"
        },
        "throttle_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "core_mhz",
        "sample_count",
        "expected_frames",
        "observed_frames",
        "query_failures",
        "stabilized"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/Tavrin/saccade/schemas/saccade-gpu-clock.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "device_id": {
      "type": "string"
    },
    "power_state": {
      "description": "Explicit producer power state, e.g. `ac-performance`. Unknown is absent.",
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "type": "string"
    },
    "windows": {
      "items": {
        "$ref": "#/$defs/ClockWindow"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "device_id",
    "windows"
  ],
  "title": "GpuClock",
  "type": "object"
}
