{
  "$defs": {
    "Arm": {
      "properties": {
        "combined_verdict": {
          "type": "string"
        },
        "config_differs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "excluded_repeats": {
          "default": [],
          "description": "Repeats excluded before measurement, with a specific reason.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "flag": {
          "type": "string"
        },
        "frame_change": {
          "$ref": "#/$defs/FrameChange",
          "default": "unknown"
        },
        "frame_delta": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "image_effect": {
          "$ref": "#/$defs/ImageEffect",
          "default": "unknown"
        },
        "image_verdict": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "next_actions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "no_effect": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "perf_diff": {
          "anyOf": [
            {
              "$ref": "#/$defs/PerfDiff"
            },
            {
              "type": "null"
            }
          ]
        },
        "perf_errors": {
          "items": {
            "$ref": "#/$defs/PerfError"
          },
          "type": "array"
        },
        "perf_only": {
          "type": "boolean"
        },
        "repeat_stability": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepeatStability"
            },
            {
              "type": "null"
            }
          ]
        },
        "repeats": {
          "default": [],
          "description": "Complete captures used for this arm, in stable order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "report_html": {
          "type": "string"
        },
        "top_deltas": {
          "items": {
            "$ref": "#/$defs/TermDiff"
          },
          "type": "array"
        },
        "validity_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "label",
        "path",
        "image_verdict",
        "top_deltas",
        "config_differs",
        "no_effect",
        "perf_only",
        "flag",
        "combined_verdict",
        "errors",
        "perf_errors",
        "report_html"
      ],
      "type": "object"
    },
    "Attribution": {
      "enum": [
        "complete",
        "partial",
        "inconsistent",
        "unavailable"
      ],
      "type": "string"
    },
    "ClockRange": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "format": "double",
          "type": "number"
        },
        "median": {
          "format": "double",
          "type": "number"
        },
        "min": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "min",
        "median",
        "max"
      ],
      "type": "object"
    },
    "ClockWindow": {
      "additionalProperties": false,
      "properties": {
        "core_mhz": {
          "$ref": "#/$defs/ClockRange"
        },
        "expected_frames": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "memory_mhz": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClockRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "observed_frames": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "query_failures": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sample_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stabilized": {
          "type": "boolean"
        },
        "throttle_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "core_mhz",
        "sample_count",
        "expected_frames",
        "observed_frames",
        "query_failures",
        "stabilized"
      ],
      "type": "object"
    },
    "Comparability": {
      "enum": [
        "qualified",
        "rejected",
        "unknown"
      ],
      "type": "string"
    },
    "CounterDiff": {
      "properties": {
        "after": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "before": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "beyond_noise": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "delta": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "delta_pct": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "noise_floor": {
          "description": "Raw repeat range in ms.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "noise_threshold": {
          "default": null,
          "description": "Effective threshold: max(k × range, ticks × quantum, absolute/relative minimum).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "description": "paired, appeared, disappeared, or not_comparable.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "type": "object"
    },
    "Delta": {
      "properties": {
        "after": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "before": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "beyond_noise": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "delta": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "delta_pct": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "noise_floor": {
          "description": "Raw repeat range in ms.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "noise_threshold": {
          "default": null,
          "description": "Effective threshold: max(k × range, ticks × quantum, absolute/relative minimum).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "description": "paired, appeared, disappeared, or not_comparable.",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "Digest": {
      "description": "Validated lowercase SHA-256 identity or content hash.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "FrameChange": {
      "enum": [
        "faster",
        "slower",
        "within_measured_noise",
        "unknown"
      ],
      "type": "string"
    },
    "GpuClock": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string"
        },
        "power_state": {
          "description": "Explicit producer power state, e.g. `ac-performance`. Unknown is absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "schema": {
          "type": "string"
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/ClockWindow"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "device_id",
        "windows"
      ],
      "type": "object"
    },
    "ImageEffect": {
      "enum": [
        "identical",
        "changed",
        "unknown"
      ],
      "type": "string"
    },
    "Kind": {
      "enum": [
        "pass",
        "gap",
        "scope"
      ],
      "type": "string"
    },
    "Materiality": {
      "properties": {
        "blocks_no_effect": {
          "type": "boolean"
        },
        "floor_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unexplained_upper_bound_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "blocks_no_effect",
        "reasons"
      ],
      "type": "object"
    },
    "PerfContext": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "description": "joint_partition means terms account for this frame's measured window.\nindependent_statistics never supplies an additive frame remainder.",
          "type": "string"
        },
        "attribution_coverage": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "capture_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "configuration_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "hardware": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "measurement": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "producer": {
          "type": "string"
        },
        "producer_version": {
          "type": "string"
        },
        "qualification": {
          "$ref": "#/$defs/Qualification"
        },
        "quantum_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "raw_samples": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "type": "array"
        },
        "sample_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "timer": {
          "type": [
            "string",
            "null"
          ]
        },
        "unavailable_terms": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnavailableTerm"
          },
          "type": "array"
        },
        "unresolved_remainder_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "raw_samples",
        "hardware",
        "aggregation",
        "producer",
        "producer_version",
        "qualification"
      ],
      "type": "object"
    },
    "PerfDiff": {
      "properties": {
        "attribution": {
          "$ref": "#/$defs/Attribution",
          "default": "unavailable"
        },
        "comparability": {
          "$ref": "#/$defs/Comparability",
          "default": "unknown"
        },
        "context_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/PerfContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context_before": {
          "anyOf": [
            {
              "$ref": "#/$defs/PerfContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Producer evidence is retained in analytical reports, including its hashes."
        },
        "frame": {
          "$ref": "#/$defs/Delta"
        },
        "frame_change": {
          "$ref": "#/$defs/FrameChange",
          "default": "unknown"
        },
        "gpu_clock_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuClock"
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu_clock_before": {
          "anyOf": [
            {
              "$ref": "#/$defs/GpuClock"
            },
            {
              "type": "null"
            }
          ]
        },
        "materiality": {
          "$ref": "#/$defs/Materiality",
          "default": {
            "blocks_no_effect": false,
            "floor_ms": null,
            "reasons": [],
            "unexplained_upper_bound_ms": null
          }
        },
        "min_delta_ms": {
          "default": 0.05,
          "format": "double",
          "type": "number"
        },
        "min_delta_pct": {
          "default": 0.5,
          "format": "double",
          "type": "number"
        },
        "minimum_delta_ms": {
          "default": 0.0,
          "description": "max(min_delta_ms, baseline frame × min_delta_pct / 100).",
          "format": "double",
          "type": "number"
        },
        "noise_comparability": {
          "$ref": "#/$defs/Comparability",
          "default": "unknown"
        },
        "noise_k": {
          "format": "double",
          "type": "number"
        },
        "policy_sources": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Effective policy sources: explicit options, repeat calibration or defaults.",
          "type": "object"
        },
        "qualification_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resolution_ms": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "resolution_ticks": {
          "default": 2,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "schema": {
          "type": "string"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/TermDiff"
          },
          "type": "array"
        },
        "unattributed_after": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "unattributed_before": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "unit",
        "noise_k",
        "frame",
        "terms",
        "warnings"
      ],
      "type": "object"
    },
    "PerfError": {
      "properties": {
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "message"
      ],
      "type": "object"
    },
    "Qualification": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "additionalProperties": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "description": "Missing checks remain unknown; matching false checks reject both sides.",
          "type": "object"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rule": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Comparability"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "rule",
        "version",
        "checks",
        "reasons"
      ],
      "type": "object"
    },
    "RepeatStability": {
      "properties": {
        "image_hashes": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "File SHA-256 values per image, in repeat order.",
          "type": "object"
        },
        "max_flip_by_image": {
          "additionalProperties": {
            "format": "double",
            "type": "number"
          },
          "default": {},
          "description": "Largest repeat-to-first FLIP max for every image, when computable.",
          "type": "object"
        },
        "stable": {
          "description": "Native samples match across every complete repeat.",
          "type": "boolean"
        },
        "unstable_images": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "stable",
        "unstable_images",
        "image_hashes"
      ],
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "hash": {
          "$ref": "#/$defs/Digest"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "hash"
      ],
      "type": "object"
    },
    "TermDiff": {
      "properties": {
        "after": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "after_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/Kind"
            },
            {
              "type": "null"
            }
          ]
        },
        "after_parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "before": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "before_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/Kind"
            },
            {
              "type": "null"
            }
          ]
        },
        "before_parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "beyond_noise": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "counters": {
          "items": {
            "$ref": "#/$defs/CounterDiff"
          },
          "type": "array"
        },
        "delta": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "delta_pct": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "label": {
          "type": "string"
        },
        "noise_floor": {
          "description": "Raw repeat range in ms.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "noise_threshold": {
          "default": null,
          "description": "Effective threshold: max(k × range, ticks × quantum, absolute/relative minimum).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "share_after": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "share_before": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "description": "paired, appeared, disappeared, or not_comparable.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "status",
        "counters"
      ],
      "type": "object"
    },
    "UnavailableTerm": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "upper_bound_ms": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/Tavrin/saccade/schemas/saccade-ablate.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "arms": {
      "items": {
        "$ref": "#/$defs/Arm"
      },
      "type": "array"
    },
    "base": {
      "type": "string"
    },
    "base_repeats": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "base_stability": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepeatStability"
        },
        {
          "type": "null"
        }
      ]
    },
    "excluded_base_repeats": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "repeat_qualification": {
      "$ref": "#/$defs/Comparability",
      "default": "unknown"
    },
    "repeat_reasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "base",
    "arms"
  ],
  "title": "Ablation",
  "type": "object"
}
