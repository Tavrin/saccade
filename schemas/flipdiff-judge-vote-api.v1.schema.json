{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/flipdiff/schemas/flipdiff-judge-vote-api.v1.schema.json",
  "type": "object",
  "required": [
    "schema",
    "voter",
    "done",
    "total"
  ],
  "properties": {
    "schema": {
      "const": "flipdiff-judge-vote-api.v1"
    },
    "voter": {
      "type": "string"
    },
    "done": {
      "type": "integer",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "kind_limits",
          "choices"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^i_[0-9a-f]{32}$"
          },
          "choices": {
            "type": "array",
            "minItems": 2
          }
        }
      }
    }
  }
}
