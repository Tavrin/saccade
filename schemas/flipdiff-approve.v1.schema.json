{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/flipdiff/schemas/flipdiff-approve.v1.schema.json",
  "title": "flipdiff-approve.v1",
  "description": "Printed by `flipdiff approve --json`; paths are absolute.",
  "type": "object",
  "required": [
    "schema",
    "copied",
    "pruned"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "flipdiff-approve.v1"
    },
    "copied": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "pruned": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
