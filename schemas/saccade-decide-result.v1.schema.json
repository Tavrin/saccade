{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/schemas/saccade-decide-result.v1.schema.json",
  "title": "saccade-decide-result.v1",
  "description": "Printed by `saccade decide --json`, one object per recorded answer.",
  "type": "object",
  "required": [
    "schema",
    "entry",
    "question",
    "answer",
    "source",
    "proposed",
    "decided",
    "decision",
    "reason",
    "file"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "saccade-decide-result.v1"
    },
    "entry": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "proposed": {
      "type": "boolean",
      "description": "True for every non-human source: the answer is advice."
    },
    "decided": {
      "type": "boolean",
      "description": "True when the answer became the set's decision (a person's, or a model's promoted by the confidence gate)."
    },
    "decision": {
      "enum": [
        "accept",
        "reject",
        "needs-work",
        null
      ],
      "description": "The set's decision after recording."
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Why a proposal was not promoted."
    },
    "file": {
      "type": "string",
      "description": "The decisions file written (absolute)."
    }
  }
}
