{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/schemas/saccade-judge-selftest.v1.schema.json",
  "type": "object",
  "required": [
    "schema",
    "dry_run",
    "calls_planned",
    "calls_made",
    "perturbations",
    "judges",
    "reading"
  ],
  "properties": {
    "schema": {
      "const": "saccade-judge-selftest.v1"
    },
    "dry_run": {
      "type": "boolean"
    },
    "calls_made": {
      "type": "integer",
      "minimum": 0
    },
    "judges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "judge",
          "flip_rate",
          "stable"
        ]
      }
    }
  }
}
