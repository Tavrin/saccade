{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tavrin/saccade/schemas/saccade-error.v1.schema.json",
  "title": "saccade-error.v1",
  "description": "Printed on stdout, with the command's exit code, when a command run with --json (or --format json) fails.",
  "type": "object",
  "required": [
    "schema",
    "code",
    "message",
    "hint"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "saccade-error.v1"
    },
    "code": {
      "enum": [
        "usage",
        "io",
        "config",
        "unsafe_path",
        "not_empty_out_dir",
        "nothing_compared",
        "approve_mismatch"
      ]
    },
    "message": {
      "type": "string"
    },
    "hint": {
      "type": "string",
      "description": "Offending path or argument and how to repair it."
    }
  }
}
